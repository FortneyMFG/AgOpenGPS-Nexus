root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,sln}]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:silent
dotnet_diagnostic.IDE0005.severity = warning
