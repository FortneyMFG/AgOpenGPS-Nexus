<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="../../proto/capabilities.proto" GrpcServices="Client;Server" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/core.proto" GrpcServices="Client;Server" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/agio_sim.proto" GrpcServices="Client;Server" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/aog_link.proto" GrpcServices="None" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/guidance.proto" GrpcServices="None" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/nanopb.proto" GrpcServices="None" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/nexus/cli/reflection.proto" GrpcServices="Client" ProtoRoot="../../proto" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.25.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.59.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.59.0" />
    <PackageReference Include="Grpc.Tools" Version="2.59.0" PrivateAssets="All" />
    <PackageReference Include="Avalonia" Version="11.3.7" />
  </ItemGroup>
</Project>
