{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AgioHost": {
    "Backend": {
      "Assembly": "Aog.Agio.Sim",
      "Type": "Aog.Agio.Sim.SimAgioBackend"
    },
    "Safety": {
      "HeartbeatMs": 250,
      "Failsafe": {
        "Steer": "disable",
        "Sections": "disable"
      }
    },
    "SafetyLogs": {
      "Directory": "logs/safety",
      "RetentionDays": 30,
      "MaxFiles": 90
    }
  }
}
