{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "CoreHost": {
    "Health": {
      "IntervalSeconds": 30
    },
    "Agio": {
      "Endpoint": "https://localhost:5105",
      "AllowUnencryptedHttp2": false
    },
    "Capabilities": {
      "NodeId": "core-host",
      "SessionPrefix": "core-",
      "AdvertisedCapabilities": [
        "nav.pose",
        "nav.imu"
      ],
      "DefaultCapabilityVersion": "1.0.0",
      "DefaultCapabilitySummary": "Core telemetry stream"
    },
    "Jobs": {
      "RootDirectory": "jobs",
      "ActiveStateFileName": "active.json",
      "DefaultSessionName": "Session 1"
    }
  }
}
