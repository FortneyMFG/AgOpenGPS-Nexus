<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <UseLocalAogAbstractions Condition="'$(UseLocalAogAbstractions)' == '' and Exists('..\Aog.Abstractions\Aog.Abstractions.csproj')">true</UseLocalAogAbstractions>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalAogAbstractions)' == 'true'">
    <ProjectReference Include="..\Aog.Abstractions\Aog.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalAogAbstractions)' != 'true'">
    <PackageReference Include="AgOpenGPS.Aog.Abstractions" Version="$(AogAbstractionsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" Version="5.5.3" />
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
    <PackageReference Include="NetTopologySuite.IO.ShapeFile" Version="2.5.0" />
  </ItemGroup>
</Project>
