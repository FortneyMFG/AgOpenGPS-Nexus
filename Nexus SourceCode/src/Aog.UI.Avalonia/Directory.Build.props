<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);USE_AVALONIA_NATIVE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Forward Avalonia.OpenGL types through Avalonia.Native -->
        <Using Include="Avalonia.OpenGL" Alias="OpenGLApi" />
        <Using Include="Avalonia.Native" Alias="NativeApi" />
    </ItemGroup>
</Project>