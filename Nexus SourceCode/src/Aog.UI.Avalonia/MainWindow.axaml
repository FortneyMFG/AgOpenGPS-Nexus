<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:Aog.UI.Avalonia.Controls"
        x:Class="Aog.UI.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1000"
        Height="700"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Theme" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding AvailableThemes}"
                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                  Width="140"/>
      </StackPanel>
    </Grid>

    <!-- Content -->
    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="24" Margin="0,24,0,0">
      <!-- Left: Map -->
      <Border Grid.Column="0"
              CornerRadius="12"
              Background="{DynamicResource ThemeBackgroundBrush}"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1">
        <controls:MapView VehiclePose="{Binding VehiclePose}"
                          CoverageCells="{Binding CoverageCells}"
                          GuidanceTracks="{Binding GuidanceTracks}"/>
      </Border>

      <!-- Right: Info + Controls -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding PlatformDescription}" TextWrapping="Wrap"/>
          <TextBlock Text="Use the mouse wheel to zoom and drag with the left mouse button to pan the map." TextWrapping="Wrap"/>
          <TextBlock Text="The highlighted dot shows the current vehicle position and heading." TextWrapping="Wrap"/>

          <!-- Simulation controls -->
          <Border Padding="16" CornerRadius="8"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Simulation controls" FontWeight="SemiBold"/>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="{Binding SimulationBar.ActiveScenarioTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SimulationBar.ActiveScenarioDescription}" TextWrapping="Wrap"/>
                  <TextBlock Text="Options: {Binding SimulationBar.ActiveScenarioOptions}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Edit scenarios..."
                        Padding="12,4"
                        HorizontalAlignment="Right"
                        Click="OnOpenScenarioEditor"/>
              </Grid>

              <!-- Transport + playback rates -->
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="{Binding SimulationBar.PlayPauseLabel}"
                        Command="{Binding SimulationBar.TogglePlaybackCommand}"
                        MinWidth="96"/>
                <TextBlock Text="{Binding SimulationBar.StatusText}" VerticalAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding SimulationBar.PlaybackRates}" Margin="16,0,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton Content="{Binding Label}"
                                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   Command="{Binding SelectCommand}"
                                   GroupName="PlaybackRates"
                                   Padding="12,4"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding SimulationBar.SelectedPlaybackRateLabel}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Scrubber -->
              <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding SimulationBar.PositionDisplay}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1"
                        Minimum="0" Maximum="1"
                        Value="{Binding SimulationBar.SeekFraction}"
                        SmallChange="0.01" LargeChange="0.1"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SimulationBar.DurationDisplay}"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Stream routing -->
              <StackPanel Grid.Row="4" Margin="0,4,0,0" Spacing="8">
                <TextBlock Text="Stream routing" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SimulationBar.Routes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,3*,2*" Margin="0,4,0,4" ColumnSpacing="8">
                        <TextBlock Text="{Binding Stream}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableSources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  MinWidth="160"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AvailableModes}"
                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  MinWidth="140"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Plugin panels -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8" DataContext="{Binding SteerPanel}" x:DataType="vm:SteerPanelViewModel">
                <TextBlock Text="Steer" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <ToggleSwitch Content="Enable" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                  <TextBlock Text="Target" VerticalAlignment="Center"/>
                  <Slider Width="160"
                          Minimum="{Binding MinimumWheelAngleDegrees}"
                          Maximum="{Binding MaximumWheelAngleDegrees}"
                          Value="{Binding TargetWheelAngleDegrees, Mode=TwoWay}"
                          SmallChange="0.5"
                          LargeChange="2"/>
                  <TextBlock Text="{Binding TargetWheelAngleDegrees, StringFormat='{}{0:F1}°'}"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Feed-forward" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FeedForward, StringFormat='{}{0:F2}'}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Controller output" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ControllerOutput, StringFormat='{}{0:F2}'}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="8" DataContext="{Binding SectionsPanel}" x:DataType="vm:SectionsPanelViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Sections" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <ToggleSwitch Content="Auto" IsChecked="{Binding IsAutoEnabled, Mode=TwoWay}"/>
                  <TextBlock Text="{Binding MaskDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionToggleViewModel">
                      <ToggleButton Content="{Binding Label}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    Width="72"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsVisible}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8" DataContext="{Binding PlanterPanel}" x:DataType="vm:PlanterPanelViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Planter" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanterRowViewModel">
                      <Border Padding="8" Margin="0,0,0,6" Background="{DynamicResource ThemeBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,*,*,*,*,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding RowLabel}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding TargetPopulationDisplay}"/>
                          <TextBlock Grid.Column="2" Text="{Binding ActualPopulationDisplay}"/>
                          <TextBlock Grid.Column="3" Text="{Binding PopulationErrorDisplay}"/>
                          <TextBlock Grid.Column="4" Text="{Binding SkipRateDisplay}"/>
                          <TextBlock Grid.Column="5" Text="{Binding DoubleRateDisplay}"/>
                          <TextBlock Grid.Column="6" Text="{Binding QualityDisplay}" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="12" DataContext="{Binding SteerDashboard}" x:DataType="vm:SteerDashboardViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Autosteer dashboard" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Status}" Foreground="#99000000"/>
                </StackPanel>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="Cross-track error" FontWeight="SemiBold"/>
                      <controls:Sparkline Values="{Binding CrossTrackErrorHistory}" Height="60" StrokeThickness="2.5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Wheel angle" FontWeight="SemiBold"/>
                      <controls:Sparkline Values="{Binding WheelAngleHistory}" Height="60" Stroke="#FF35A1FF" Fill="#2035A1FF"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Controller output" FontWeight="SemiBold"/>
                      <controls:Sparkline Values="{Binding ControllerOutputHistory}" Height="60" Stroke="#FFFFD700" Fill="#20FFD700"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="Tuning" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="P" VerticalAlignment="Center"/>
                      <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding ProportionalGain, Mode=TwoWay}"/>
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProportionalGain, StringFormat='{}{0:0.00}'}" VerticalAlignment="Center"/>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="I" VerticalAlignment="Center"/>
                      <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.5" Value="{Binding IntegralGain, Mode=TwoWay}"/>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding IntegralGain, StringFormat='{}{0:0.00}'}" VerticalAlignment="Center"/>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="D" VerticalAlignment="Center"/>
                      <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding DerivativeGain, Mode=TwoWay}"/>
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DerivativeGain, StringFormat='{}{0:0.00}'}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding GainSummary}" Foreground="#99000000"/>

                    <StackPanel>
                      <TextBlock Text="Recent tuning events" FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding TuningEvents}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SteerTuningEventViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <TextBlock Text="{Binding DisplayTimestamp}" FontFamily="Consolas, Courier New, monospace"/>
                              <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Replay analysis timeline -->
          <Border Padding="16" CornerRadius="12" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1" DataContext="{Binding ReplayTimeline}" x:DataType="vm:ReplayTimelineViewModel">
            <StackPanel Spacing="12">
              <TextBlock Text="Replay analysis timeline" FontSize="20" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Speed (m/s)" FontWeight="SemiBold"/>
                  <controls:Sparkline Values="{Binding SpeedSamples}" Height="70" Stroke="#FF11C98D" Fill="#2011C98D"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Heading change (°)" FontWeight="SemiBold"/>
                  <controls:Sparkline Values="{Binding HeadingSamples}" Height="70" Stroke="#FF35A1FF" Fill="#2035A1FF"/>
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReplayTimelineBookmarkViewModel">
                    <Border Padding="8" Margin="0,0,0,6" Background="#05000000" BorderBrush="#19000000" BorderThickness="1" CornerRadius="4">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="{Binding TimestampDisplay}" FontFamily="Consolas, Courier New, monospace"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Right">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" MinWidth="100"/>
                <Button Grid.Column="1" Content="Export GeoJSON" Command="{Binding ExportGeoJsonCommand}" MinWidth="120"/>
              </Grid>
              <TextBlock Text="{Binding ExportStatus}" Foreground="#99000000" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Privacy & telemetry -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding TelemetryPrivacy}">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Crash telemetry" FontSize="20" FontWeight="SemiBold"/>
                <ToggleSwitch Content="Share reports" IsChecked="{Binding IsTelemetryOptedIn, Mode=TwoWay}"/>
              </StackPanel>

              <TextBlock Text="{Binding PendingReportSummary}" TextWrapping="Wrap"/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Upload pending"
                        Command="{Binding UploadReportsCommand}"
                        IsEnabled="{Binding HasPendingReports}"/>
                <Button Content="Clear pending"
                        Command="{Binding ClearReportsCommand}"
                        IsEnabled="{Binding HasPendingReports}"/>
              </StackPanel>

              <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Simulation graph summary -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <TextBlock Text="Embedded simulation provider graph" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SimulationGraphSummary}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="160"
                       FontFamily="Consolas, Courier New, monospace"/>
            </Grid>
          </Border>

          <!-- Connection settings -->
          <Border Padding="20" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="16" DataContext="{Binding Connection}" x:DataType="vm:ConnectionSettingsViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="Connection settings" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Configure how Nexus connects to AGiO and chooses GPS sources."
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="AGiO endpoint" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Grid.Row="0"
                           Text="{Binding AgioEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Watermark="e.g. http://localhost:50051"/>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Backend" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" Grid.Row="1"
                           Items="{Binding AvailableBackends}"
                           SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"/>

                <TextBlock Grid.Column="0" Grid.Row="2" Text="GPS source policy" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" Grid.Row="2"
                           Items="{Binding AvailableGpsSourcePolicies}"
                           SelectedItem="{Binding SelectedGpsSourcePolicy, Mode=TwoWay}"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock#StatusText">
                      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                      <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                      </DataTrigger>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>

                <Button Grid.Column="1"
                        Content="Save settings"
                        Command="{Binding SaveCommand}"
                        MinWidth="140"
                        HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
