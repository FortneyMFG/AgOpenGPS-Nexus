<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        x:Class="Aog.UI.Avalonia.MainWindow"
        Title="{Binding Title}"
        Width="800"
        Height="600"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"/>
    <Border Grid.Row="1" Margin="0,24,0,0" Padding="16" CornerRadius="8" Background="#0F000000">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Text="Welcome to the AgOpenGPS Nexus shell" FontSize="18"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding PlatformDescription}"/>
        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="This bootstrap window is backed by dependency injection."/>
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12" CornerRadius="6" Background="#12000000">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Simulation controls" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Center">
              <Button Content="{Binding SimulationBar.PlayPauseLabel}" Command="{Binding SimulationBar.TogglePlaybackCommand}" MinWidth="96"/>
              <TextBlock Text="{Binding SimulationBar.StatusText}" VerticalAlignment="Center"/>
              <ItemsControl ItemsSource="{Binding SimulationBar.PlaybackRates}" Margin="16,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Content="{Binding Label}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 Command="{Binding SelectCommand}"
                                 GroupName="PlaybackRates"
                                 Padding="12,4"
                                 HorizontalAlignment="Center"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SimulationBar.SelectedPlaybackRateLabel}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SimulationBar.PositionDisplay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Slider Grid.Column="1"
                      Minimum="0"
                      Maximum="1"
                      Value="{Binding SimulationBar.SeekFraction}"
                      SmallChange="0.01"
                      LargeChange="0.1"/>
              <TextBlock Grid.Column="2" Text="{Binding SimulationBar.DurationDisplay}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="8">
              <TextBlock Text="Stream routing" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding SimulationBar.Routes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,3*,2*" Margin="0,4,0,4">
                      <TextBlock Text="{Binding Stream}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1"
                                ItemsSource="{Binding AvailableSources}"
                                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                MinWidth="160"/>
                      <ComboBox Grid.Column="2"
                                ItemsSource="{Binding AvailableModes}"
                                SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                MinWidth="140"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="4" Spacing="4">
          <TextBlock Text="Embedded simulation provider graph" FontWeight="SemiBold"/>
          <TextBox Text="{Binding SimulationGraphSummary}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="160" FontFamily="Consolas, Courier New, monospace"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
