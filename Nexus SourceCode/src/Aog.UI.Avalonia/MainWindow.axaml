<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:Aog.UI.Avalonia.Controls"
        x:Class="Aog.UI.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1000"
        Height="700"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Theme" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding AvailableThemes}"
                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                  Width="140"/>
      </StackPanel>
    </Grid>

    <!-- Content -->
    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="24" Margin="0,24,0,0">
      <!-- Left: Map -->
      <Border Grid.Column="0"
              CornerRadius="12"
              Background="{DynamicResource ThemeBackgroundBrush}"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1">
        <Grid>
          <controls:MapView VehiclePose="{Binding VehiclePose}"
                            Layers="{Binding MapLayers}"
                            GuidanceTracks="{Binding GuidanceTracks}"/>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="16"
                  Padding="16"
                  MaxWidth="360"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  DataContext="{Binding ZoneEditorToolbar}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Zone editor" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ActiveLayerDisplayName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SessionStatusDisplay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start session" Command="{Binding StartSessionCommand}" MinWidth="110"/>
                <Button Content="Commit edit" Command="{Binding CommitSessionCommand}" MinWidth="110"/>
                <Button Content="Cancel" Command="{Binding CancelSessionCommand}" MinWidth="80"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Undo" Command="{Binding UndoCommand}" MinWidth="80"/>
                <Button Content="Redo" Command="{Binding RedoCommand}" MinWidth="80"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding UndoCount, StringFormat=Undo: {0}}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding RedoCount, StringFormat=Redo: {0}}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Tools" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Tools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ZoneEditorToolOptionViewModel">
                      <Border Margin="0,4,8,4"
                              Padding="8"
                              CornerRadius="8"
                              Background="{DynamicResource ThemeBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                              BorderThickness="1">
                        <StackPanel Spacing="4">
                          <Button Content="{Binding DisplayName}"
                                  Command="{Binding SelectCommand}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="120">
                            <Button.Styles>
                              <Style Selector="Button">
                                <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Background" Value="#FF2D5D9F"/>
                                  <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                              </Style>
                            </Button.Styles>
                          </Button>
                          <TextBlock Text="{Binding Description}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                          <TextBlock Text="{Binding Shortcut, StringFormat=Shortcut: {0}}"
                                     FontSize="10"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Snapping &amp; inspectors" FontWeight="SemiBold"/>
                <ToggleSwitch Content="Snap to field boundaries"
                              IsChecked="{Binding SnapToFieldBoundaries, Mode=TwoWay}"/>
                <ToggleSwitch Content="Snap to guidance lines"
                              IsChecked="{Binding SnapToGuidance, Mode=TwoWay}"/>
                <ToggleSwitch Content="Show attribute inspector"
                              IsChecked="{Binding ShowAttributePanel, Mode=TwoWay}"/>
              </StackPanel>

              <Border Padding="8"
                      CornerRadius="8"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Committed edits" FontWeight="SemiBold"/>
                  <ScrollViewer MaxHeight="160">
                    <ItemsControl ItemsSource="{Binding JournalEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneEditorJournalEntryViewModel">
                          <Border Padding="8"
                                  Margin="0,4"
                                  CornerRadius="6"
                                  Background="{DynamicResource ThemeBackgroundBrush}"
                                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                  BorderThickness="1">
                            <StackPanel Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Sequence, StringFormat=#{0}}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Tool}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                           Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                              </StackPanel>
                              <TextBlock Text="{Binding OperationSummary}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding DetailSummary}"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ThemeForegroundBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Right: Info + Controls -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding PlatformDescription}" TextWrapping="Wrap"/>
          <TextBlock Text="Use the mouse wheel to zoom and drag with the left mouse button to pan the map." TextWrapping="Wrap"/>
          <TextBlock Text="The highlighted dot shows the current vehicle position and heading." TextWrapping="Wrap"/>

          <!-- Device Manager compatibility -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding DeviceManagerCompatibility}"
                  x:DataType="vm:DeviceManagerCompatibilityViewModel">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Device Manager compatibility" FontSize="20" FontWeight="SemiBold"/>
                  <Border Padding="8,2"
                          CornerRadius="6"
                          Background="{DynamicResource ThemeBackgroundBrush}"
                          BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                          BorderThickness="1">
                    <TextBlock Text="{Binding SummaryTitle}" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding SummaryDescription}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding DataSourceSummary}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeviceManagerCompatibilityPluginViewModel">
                    <Border Padding="12"
                            Margin="0,4"
                            CornerRadius="8"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PluginId}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Version}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StateDisplay}"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold">
                              <TextBlock.Styles>
                                <Style Selector="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                                  <DataTrigger Binding="{Binding State}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding State}" Value="Blocked">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                  </DataTrigger>
                                </Style>
                              </TextBlock.Styles>
                            </TextBlock>
                          </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                          <TextBlock Text="Capabilities" FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding Capabilities}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Spacing="6"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Padding="6,2"
                                        CornerRadius="6"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                        BorderThickness="1"
                                        Margin="0,2">
                                  <TextBlock Text="{Binding}"
                                             FontFamily="Consolas, Courier New, monospace"/>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                          <TextBlock Text="Compatibility signals" FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:DeviceManagerCompatibilityIssueViewModel">
                                <Border Padding="8"
                                        CornerRadius="6"
                                        Margin="0,2"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                        BorderThickness="1">
                                  <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <Border Padding="6,2"
                                              CornerRadius="6"
                                              Background="{DynamicResource ThemeBackgroundBrush}"
                                              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                              BorderThickness="1">
                                        <TextBlock Text="{Binding ClassificationDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                      </Border>
                                      <TextBlock Text="{Binding KindDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                      <TextBlock Text="{Binding Identifier}"
                                                 FontFamily="Consolas, Courier New, monospace"
                                                 Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Styles>
                              <Style Selector="ItemsControl">
                                <Setter Property="IsVisible" Value="False"/>
                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                  <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                              </Style>
                            </ItemsControl.Styles>
                          </ItemsControl>
                          <TextBlock Text="No outstanding issues." Foreground="{DynamicResource ThemeForegroundLowBrush}">
                            <TextBlock.Styles>
                              <Style Selector="TextBlock">
                                <Setter Property="IsVisible" Value="False"/>
                                <DataTrigger Binding="{Binding HasIssues}" Value="False">
                                  <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                              </Style>
                            </TextBlock.Styles>
                          </TextBlock>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Layout diff viewer -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding LayoutDiff}"
                  x:DataType="vm:LayoutDiffViewModel">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Layout diff &amp; rollback" FontSize="20" FontWeight="SemiBold"/>
                <Border Padding="8,2"
                        CornerRadius="6"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding Candidate.ModeDisplay}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Padding="8,2"
                        CornerRadius="6"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasLinkedPreset}">
                  <TextBlock Text="{Binding LinkedPresetName, StringFormat=Preset: {0}}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding LayoutDisplayName}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Candidate.Summary}" TextWrapping="Wrap"/>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="Baseline" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Baseline.VersionDisplay}" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Baseline.ModeDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Baseline.UpdatedAtDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Baseline.UpdatedByDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Baseline.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Candidate" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Candidate.VersionDisplay}" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Candidate.ModeDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Candidate.UpdatedAtDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Candidate.UpdatedByDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding Candidate.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayoutDiffEntryViewModel">
                    <Border Padding="12" Margin="0,4"
                            CornerRadius="8"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Border Padding="6,2"
                                  CornerRadius="6"
                                  Background="{DynamicResource ThemeBackgroundBrush}"
                                  BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                  BorderThickness="1">
                            <TextBlock Text="{Binding ChangeKindDisplay}" FontSize="11" FontWeight="SemiBold"/>
                          </Border>
                          <TextBlock Text="{Binding ElementName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding ImpactDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                        <Border Padding="8" CornerRadius="6" Background="#0F000000" IsVisible="{Binding HasRollbackNote}">
                          <TextBlock Text="{Binding RollbackNote}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="12" CornerRadius="8" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ComparisonSummary}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                        <DataTrigger Binding="{Binding IsRollbackPending}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                        </DataTrigger>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <TextBlock Text="{Binding BreakingChangeCount, StringFormat=High impact changes: {0}}"
                             Foreground="{DynamicResource ThemeAccentBrush}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock">
                        <Setter Property="IsVisible" Value="False"/>
                        <DataTrigger Binding="{Binding HasBreakingChanges}" Value="True">
                          <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <TextBlock Text="No high-impact changes detected." Foreground="{DynamicResource ThemeForegroundLowBrush}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock">
                        <Setter Property="IsVisible" Value="False"/>
                        <DataTrigger Binding="{Binding HasBreakingChanges}" Value="False">
                          <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="Apply candidate" Command="{Binding ApplyCandidateCommand}" MinWidth="140"/>
                <Button Content="Rollback to baseline" Command="{Binding RollbackCommand}" MinWidth="160"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Mesh sharing panel -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding MeshSharePanel}"
                  x:DataType="vm:MeshSharePanelViewModel">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Mesh sharing" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MeshDeviceAccessViewModel">
                    <Border Padding="12" Margin="0,4"
                            CornerRadius="10"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding DeviceId}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding PresenceDisplay}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding LastSeenDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CapabilitySummary}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>

                        <StackPanel Spacing="4" IsVisible="{Binding HasShareGrants}">
                          <TextBlock Text="Shares" FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding ShareGrants}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MeshAccessGrantViewModel">
                                <Border Padding="8" Margin="0,2"
                                        CornerRadius="6"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                        BorderThickness="1">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ScopeDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TierDisplay}"/>
                                    <TextBlock Text="{Binding LayerDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource ThemeForegroundLowBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasSubscribeGrants}">
                          <TextBlock Text="Subscriptions" FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding SubscribeGrants}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MeshAccessGrantViewModel">
                                <Border Padding="8" Margin="0,2"
                                        CornerRadius="6"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                        BorderThickness="1">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding ScopeDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TierDisplay}"/>
                                    <TextBlock Text="{Binding LayerDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource ThemeForegroundLowBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNote}"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Layer legend -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding LayerLegend}" x:DataType="vm:LayerLegendViewModel">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Layer legend" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Legend entries derive from the layer registry metadata and update automatically when plugins publish new layers." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayerLegendEntryViewModel">
                    <Border Padding="12"
                            Margin="0,4"
                            CornerRadius="8"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <Border Padding="6,2"
                                  CornerRadius="6"
                                  Background="{DynamicResource ThemeBackgroundBrush}"
                                  BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                  BorderThickness="1">
                            <TextBlock Text="{Binding ModeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <Border Height="16" CornerRadius="6" Background="{Binding GradientBrush}"/>
                        <TextBlock Text="{Binding RangeDisplay}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Layer inspector -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding LayerInspector}" x:DataType="vm:LayerInspectorViewModel">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Layer inspector" FontSize="20" FontWeight="SemiBold"/>
                <Border Padding="6,2"
                        CornerRadius="6"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding ModeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{Binding LayerName}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Padding="12" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Value" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ValueDisplay}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Target" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding TargetDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Quality" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QualityDisplay}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RateAvailabilityDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                    <TextBlock Text="Sample weight" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding WeightDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="Last sample" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding TimestampDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding LocationDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Source" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SourceDisplay}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="Transport metadata" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding TransportMetadata}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LayerInspectorFieldViewModel">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="Payload metadata" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding PayloadMetadata}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LayerInspectorFieldViewModel">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Description}"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Zone policies -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding ZonePolicyPanel}" x:DataType="vm:ZoneConstraintPolicyViewModel">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Zone policies" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PolicySummary}" TextWrapping="Wrap"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Toggles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ZoneConstraintToggleViewModel">
                    <Border Padding="12"
                            Margin="0,4"
                            CornerRadius="8"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <ToggleSwitch Content="{Binding EnforcementDisplay}"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BufferSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        <TextBlock Text="{Binding PolicySummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OverridePolicyHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasOverridePolicyHint}"/>
                        <TextBlock Text="{Binding OverrideStatusDisplay}"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SupportsManualOverride}">
                          <Button Content="Apply override"
                                  Command="{Binding ApplyOverrideCommand}"
                                  MinWidth="120"/>
                          <Button Content="Clear override"
                                  Command="{Binding ClearOverrideCommand}"
                                  MinWidth="120"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="12"
                      CornerRadius="8"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Override history" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding OverrideHistory}" IsVisible="{Binding HasOverrideHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ZoneOverrideEventViewModel">
                        <Border Padding="8"
                                Margin="0,4"
                                CornerRadius="6"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding ZoneTypeDisplay}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding ActionDisplay}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding TimestampDisplay}"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                              <TextBlock Text="{Binding ExpiryDisplay}"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DetailDisplay}"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="No overrides recorded." Foreground="{DynamicResource ThemeForegroundLowBrush}"
                             HorizontalAlignment="Center" IsVisible="{Binding HasNoOverrideHistory}"/>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ThemeForegroundBrush}"/>
            </StackPanel>
          </Border>

          <!-- Zone import/export -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding ZoneImportExportPanel}" x:DataType="vm:ZoneImportExportPanelViewModel">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Zone import &amp; export" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Workflows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ZoneImportWorkflowViewModel">
                    <Border Padding="12"
                            Margin="0,4"
                            CornerRadius="8"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding WorkflowName}" FontWeight="SemiBold"/>
                          <Border Padding="6,2"
                                  CornerRadius="6"
                                  Background="{DynamicResource ThemeBackgroundBrush}"
                                  BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                  BorderThickness="1">
                            <TextBlock Text="{Binding WorkflowTypeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TransportSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PolicySummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                   TextWrapping="Wrap"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusDisplay}"/>
                          <TextBlock Text="{Binding LastRunDisplay, StringFormat=Last run: {0}}"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="{Binding ActionLabel}"
                                  Command="{Binding ExecuteCommand}"
                                  MinWidth="140"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="12"
                      CornerRadius="8"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Activity log" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding ActivityLog}" IsVisible="{Binding HasActivity}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ZoneTransferEventViewModel">
                        <Border Padding="8"
                                Margin="0,4"
                                CornerRadius="6"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding WorkflowName}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding ActionDisplay}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding TimestampDisplay}"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                       TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="No zone transfers recorded yet."
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"
                             HorizontalAlignment="Center"
                             IsVisible="{Binding HasNoActivity}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Season navigator -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <StackPanel DataContext="{Binding SeasonNavigator}" Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Season navigator" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Switch between season contexts to drill into participating farms and job timelines." TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox Width="220"
                         Watermark="Search seasons, farms, or jobs"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ToggleSwitch Content="Active seasons only"
                              IsChecked="{Binding ShowOnlyActiveSeasons, Mode=TwoWay}"/>
              </StackPanel>

              <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
                <Border CornerRadius="8"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1">
                  <Grid>
                    <ListBox ItemsSource="{Binding Seasons}"
                             SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                             Margin="4"
                             MinHeight="200">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SeasonSummaryViewModel">
                          <Border Padding="12"
                                  Margin="0,4"
                                  CornerRadius="8"
                                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                  BorderThickness="1"
                                  Background="{DynamicResource ThemeBackgroundBrush}">
                            <StackPanel Spacing="6">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <Border Padding="6,2"
                                        CornerRadius="6"
                                        Background="{DynamicResource ThemeBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                        BorderThickness="1">
                                  <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding DateRangeDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                              <TextBlock Text="{Binding FarmListDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding JobCountDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                <TextBlock Text="{Binding LastUpdatedDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No seasons match your filters."
                               Foreground="{DynamicResource ThemeForegroundLowBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsEmpty}"/>
                  </Grid>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding SelectedSeason}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SeasonSummaryViewModel">
                      <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/>
                            <Border Padding="8,2"
                                    CornerRadius="6"
                                    Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                    BorderThickness="1">
                              <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding DateRangeDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                          <TextBlock Text="{Binding FarmListDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding CreatedByDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
                          <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="4"
                                  MinHeight="200">
                            <ListBox ItemsSource="{Binding Jobs}"
                                     SelectedItem="{Binding SelectedJob, Mode=TwoWay}">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SeasonJobViewModel">
                                  <Border Padding="12"
                                          Margin="0,4"
                                          CornerRadius="8"
                                          BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                          BorderThickness="1"
                                          Background="{DynamicResource ThemeBackgroundBrush}">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                      <TextBlock Text="{Binding ActivitySummary}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Border>

                          <ContentControl Grid.Column="1" Content="{Binding SelectedJob}">
                            <ContentControl.ContentTemplate>
                              <DataTemplate x:DataType="vm:SeasonJobViewModel">
                                <Border Padding="16"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource ThemeBackgroundBrush}">
                                  <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                    <TextBlock Text="{Binding ActivitySummary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ScheduleDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                    <TextBlock Text="{Binding LastWorkedDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ContentControl.ContentTemplate>
                          </ContentControl>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Crop quick-select -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding CropQuickSelect}" x:DataType="vm:CropQuickSelectViewModel">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8">
                <TextBlock Text="Crop quick-select" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PanelDescription}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
              </StackPanel>

              <Border Padding="12" CornerRadius="10"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ActiveFieldDisplay}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SeasonContextDisplay}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding CurrentPlanDisplay}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                  <TextBlock Text="{Binding LastActionDisplay}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>
              </Border>

              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectionStatus}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectionDetails}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CropQuickSelectGroupViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ThemeForegroundLowBrush}"/>

                      <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Spacing="12"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CropQuickSelectOptionViewModel">
                            <Border Margin="0,0,12,12" Padding="0"
                                    CornerRadius="10"
                                    BorderThickness="1.5"
                                    BorderBrush="{Binding AccentBrush}">
                              <Border.Styles>
                                <Style Selector="Border">
                                  <Setter Property="Background" Value="{Binding AccentBackgroundBrush}"/>
                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{Binding AccentBrush}"/>
                                  </DataTrigger>
                                </Style>
                              </Border.Styles>

                              <Button Command="{Binding SelectCommand}"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      Padding="12"
                                      HorizontalContentAlignment="Stretch"
                                      MinWidth="220">
                                <Button.Styles>
                                  <Style Selector="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                      <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                  </Style>
                                </Button.Styles>

                                <StackPanel Spacing="6">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Crop}" FontSize="16" FontWeight="SemiBold"/>
                                    <Border Background="{Binding AccentBrush}" Opacity="0.85"
                                            CornerRadius="4" Padding="6,2"
                                            IsVisible="{Binding HasTag}">
                                      <TextBlock Text="{Binding TagLabel}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                  </StackPanel>

                                  <TextBlock Text="{Binding Variety}" FontWeight="SemiBold"
                                             FontSize="13"
                                             IsVisible="{Binding HasVariety}"/>

                                  <TextBlock Text="{Binding SeasonWindow}"
                                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>

                                  <TextBlock Text="{Binding RotationSummary}" TextWrapping="Wrap"
                                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>

                                  <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"
                                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                                </StackPanel>
                              </Button>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Simulation controls -->
          <Border Padding="16" CornerRadius="8"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <!-- 6 rows: 0..5 used below -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Simulation controls" FontWeight="SemiBold"/>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="{Binding SimulationBar.ActiveScenarioTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SimulationBar.ActiveScenarioDescription}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SimulationBar.ActiveScenarioOptions, StringFormat=Options: {0}}"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Edit scenarios..."
                        Padding="12,4"
                        HorizontalAlignment="Right"
                        Click="OnOpenScenarioEditor"/>
              </Grid>

              <Button Grid.Row="2"
                      Content="Import legacy guidance..."
                      Padding="12,4"
                      HorizontalAlignment="Left"
                      Click="OnOpenLegacyImportWizard"/>

              <!-- Transport + playback rates -->
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="{Binding SimulationBar.PlayPauseLabel}"
                        Command="{Binding SimulationBar.TogglePlaybackCommand}"
                        MinWidth="96"/>
                <TextBlock Text="{Binding SimulationBar.StatusText}" VerticalAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding SimulationBar.PlaybackRates}" Margin="16,0,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton Content="{Binding Label}"
                                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   Command="{Binding SelectCommand}"
                                   GroupName="PlaybackRates"
                                   Padding="12,4"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding SimulationBar.SelectedPlaybackRateLabel}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Scrubber -->
              <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding SimulationBar.PositionDisplay}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1"
                        Minimum="0" Maximum="1"
                        Value="{Binding SimulationBar.SeekFraction}"
                        SmallChange="0.01" LargeChange="0.1"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding SimulationBar.DurationDisplay}"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Stream routing -->
              <StackPanel Grid.Row="5" Margin="0,4,0,0" Spacing="8">
                <TextBlock Text="Stream routing" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SimulationBar.Routes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,3*,2*" Margin="0,4,0,4" ColumnSpacing="8">
                        <TextBlock Text="{Binding Stream}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableSources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  MinWidth="160"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AvailableModes}"
                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  MinWidth="140"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Plugin panels -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="16">
              <StackPanel Spacing="8" DataContext="{Binding SteerPanel}" x:DataType="vm:SteerPanelViewModel">
                <TextBlock Text="Steer" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <ToggleSwitch Content="Enable" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                  <TextBlock Text="Target" VerticalAlignment="Center"/>
                  <Slider Width="160"
                          Minimum="{Binding MinimumWheelAngleDegrees}"
                          Maximum="{Binding MaximumWheelAngleDegrees}"
                          Value="{Binding TargetWheelAngleDegrees, Mode=TwoWay}"
                          SmallChange="0.5"
                          LargeChange="2"/>
                  <TextBlock Text="{Binding TargetWheelAngleDegrees, StringFormat='{}{0:F1}°'}"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Feed-forward" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FeedForward, StringFormat='{}{0:F2}'}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Controller output" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ControllerOutput, StringFormat='{}{0:F2}'}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="8" DataContext="{Binding SectionsPanel}" x:DataType="vm:SectionsPanelViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Sections" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <ToggleSwitch Content="Auto" IsChecked="{Binding IsAutoEnabled, Mode=TwoWay}"/>
                  <TextBlock Text="{Binding MaskDisplay}" Foreground="{DynamicResource ThemeForegroundLowBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SectionToggleViewModel">
                      <ToggleButton Content="{Binding Label}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    Width="72"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsVisible}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="8" DataContext="{Binding PlanterPanel}" x:DataType="vm:PlanterPanelViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Planter" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanterRowViewModel">
                      <Border Padding="8" Margin="0,0,0,6" Background="{DynamicResource ThemeBackgroundBrush}"
                              BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,*,*,*,*,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding RowLabel}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding TargetPopulationDisplay}"/>
                          <TextBlock Grid.Column="2" Text="{Binding ActualPopulationDisplay}"/>
                          <TextBlock Grid.Column="3" Text="{Binding PopulationErrorDisplay}"/>
                          <TextBlock Grid.Column="4" Text="{Binding SkipRateDisplay}"/>
                          <TextBlock Grid.Column="5" Text="{Binding DoubleRateDisplay}"/>
                          <TextBlock Grid.Column="6" Text="{Binding QualityDisplay}" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="12" DataContext="{Binding SteerDashboard}" x:DataType="vm:SteerDashboardViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Autosteer dashboard" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Status}" Foreground="#99000000"/>
                </StackPanel>

                <StackPanel Spacing="12">
                  <ItemsControl ItemsSource="{Binding Series}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Spacing="12"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DashboardSeriesViewModel">
                        <StackPanel MinWidth="180" Width="220" Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <controls:Sparkline Values="{Binding Values}"
                                              Height="60"
                                              Stroke="{Binding Stroke}"
                                              Fill="{Binding Fill}"
                                              StrokeThickness="{Binding StrokeThickness}"/>
                          <TextBlock Text="{Binding Units}" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Spacing="8">
                    <TextBlock Text="Tuning" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding TuningParameters}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardTuningParameterViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    Minimum="{Binding Minimum}"
                                    Maximum="{Binding Maximum}"
                                    Value="{Binding Value, Mode=TwoWay}"
                                    SmallChange="{Binding Step}"
                                    LargeChange="{Binding Step}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayValue}"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding GainSummary}" Foreground="#99000000"/>

                    <StackPanel>
                      <TextBlock Text="Recent tuning events" FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding TuningEvents}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SteerTuningEventViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <TextBlock Text="{Binding DisplayTimestamp}" FontFamily="Consolas, Courier New, monospace"/>
                              <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Replay analysis timeline -->
          <Border Padding="16" CornerRadius="12" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1" DataContext="{Binding ReplayTimeline}" x:DataType="vm:ReplayTimelineViewModel">
            <StackPanel Spacing="12">
              <TextBlock Text="Replay analysis timeline" FontSize="20" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="Speed (m/s)" FontWeight="SemiBold"/>
                  <controls:Sparkline Values="{Binding SpeedSamples}" Height="70" Stroke="#FF11C98D" Fill="#2011C98D"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Heading change (°)" FontWeight="SemiBold"/>
                  <controls:Sparkline Values="{Binding HeadingSamples}" Height="70" Stroke="#FF35A1FF" Fill="#2035A1FF"/>
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReplayTimelineBookmarkViewModel">
                    <Border Padding="8" Margin="0,0,0,6" Background="#05000000" BorderBrush="#19000000" BorderThickness="1" CornerRadius="4">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="{Binding TimestampDisplay}" FontFamily="Consolas, Courier New, monospace"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Right">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" MinWidth="100"/>
                <Button Grid.Column="1" Content="Export GeoJSON" Command="{Binding ExportGeoJsonCommand}" MinWidth="120"/>
              </Grid>
              <TextBlock Text="{Binding ExportStatus}" Foreground="#99000000" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Privacy & telemetry -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1"
                  DataContext="{Binding TelemetryPrivacy}">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Crash telemetry" FontSize="20" FontWeight="SemiBold"/>
                <ToggleSwitch Content="Share reports" IsChecked="{Binding IsTelemetryOptedIn, Mode=TwoWay}"/>
              </StackPanel>

              <TextBlock Text="{Binding PendingReportSummary}" TextWrapping="Wrap"/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Upload pending"
                        Command="{Binding UploadReportsCommand}"
                        IsEnabled="{Binding HasPendingReports}"/>
                <Button Content="Clear pending"
                        Command="{Binding ClearReportsCommand}"
                        IsEnabled="{Binding HasPendingReports}"/>
              </StackPanel>

              <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Simulation graph summary -->
          <Border Padding="16" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <TextBlock Text="Embedded simulation provider graph" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SimulationGraphSummary}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="160"
                       FontFamily="Consolas, Courier New, monospace"/>
            </Grid>
          </Border>

          <!-- Connection settings -->
          <Border Padding="20" CornerRadius="12"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="16" DataContext="{Binding Connection}" x:DataType="vm:ConnectionSettingsViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="Connection settings" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Configure how Nexus connects to AGiO and chooses GPS sources."
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="AGiO endpoint" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Grid.Row="0"
                           Text="{Binding AgioEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Watermark="e.g. http://localhost:50051"/>

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Backend" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" Grid.Row="1"
                           Items="{Binding AvailableBackends}"
                           SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"/>

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Run mode" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" Grid.Row="2"
                           Items="{Binding AvailableRunModes}"
                           SelectedItem="{Binding SelectedRunMode, Mode=TwoWay}"/>

                <TextBlock Grid.Column="0" Grid.Row="3" Text="GPS source policy" VerticalAlignment="Center"/>
                <ComboBox  Grid.Column="1" Grid.Row="3"
                           Items="{Binding AvailableGpsSourcePolicies}"
                           SelectedItem="{Binding SelectedGpsSourcePolicy, Mode=TwoWay}"/>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock#StatusText">
                      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
                      <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                      </DataTrigger>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>

                <Button Grid.Column="1"
                        Content="Save settings"
                        Command="{Binding SaveCommand}"
                        MinWidth="140"
                        HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
