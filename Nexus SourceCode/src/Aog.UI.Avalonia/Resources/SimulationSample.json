{
  "schemaVersion": "1.0.0",
  "providers": [
    {
      "providerId": "sim.clock.fixed",
      "outputs": ["time"]
    },
    {
      "providerId": "sim.vehicle.bicycle",
      "inputs": ["time"],
      "outputs": ["pose"]
    },
    {
      "providerId": "sim.imu.synthetic",
      "inputs": ["time", "pose"],
      "outputs": ["imu"]
    }
  ],
  "routes": [
    {"stream": "pose", "source": "sim.vehicle.bicycle", "mode": "simulation"},
    {"stream": "imu", "source": "sim.imu.synthetic", "mode": "simulation"}
  ],
  "options": {
    "seed": 2024,
    "timeScale": 1.0
  },
  "scenarios": [
    {
      "scenarioId": "default",
      "description": "Deterministic sample scenario embedded for diagnostics.",
      "routes": [
        {"stream": "pose", "source": "sim.vehicle.bicycle", "mode": "simulation"},
        {"stream": "imu", "source": "sim.imu.synthetic", "mode": "simulation"}
      ],
      "options": {"timeScale": 1.0}
    }
  ]
}
