<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:vm="using:Aog.UI.Avalonia.ViewModels"
        x:Class="Aog.UI.Avalonia.Views.Field.BoundaryEditor"
        x:DataType="vm:BoundaryToolViewModel"
        x:CompileBindings="True"
        Title="Field Boundary Editor"
        Width="400"
        Height="300">
  <StackPanel Margin="10">
    <TextBlock Text="Boundary Tool Options" FontWeight="Bold" Margin="0,0,0,10"/>
    <StackPanel Orientation="Horizontal" Margin="0,5">
      <Button Content="Start Recording" Command="{Binding StartRecordingCommand}" Margin="0,0,10,0"/>
      <Button Content="Stop Recording" Command="{Binding StopRecordingCommand}"/>
    </StackPanel>
    <CheckBox Content="Auto-close boundary" IsChecked="{Binding AutoCloseBoundary}" Margin="0,10"/>
    <TextBlock Text="{Binding StatusMessage}" Margin="0,10"/>
  </StackPanel>
</Window>
