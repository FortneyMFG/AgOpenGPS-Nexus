<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        x:Class="Aog.UI.Avalonia.Views.FieldOperations.FlagManagerDialog"
        x:DataType="vm:FlagManagerDialogViewModel"
        Title="Flag manager"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FlagManagerDialogViewModel, IsDesignTimeCreatable=True}">
  <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="16">
    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="Flag manager" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Review, filter, and add map flags." Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
      </StackPanel>
      <Button Content="Add flag" Command="{Binding AddFlagCommand}" MinWidth="120" HorizontalAlignment="Left"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="16">
      <Border Padding="16" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="12">
          <TextBlock Text="Filters" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Spacing="6">
            <TextBlock Text="Category" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      Watermark="All categories"
                      IsEditable="False"/>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Search" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Label or notes"/>
          </StackPanel>
          <Button Content="Clear filters" Command="{Binding ClearFilterCommand}" MinWidth="120"/>
          <Border Padding="12" CornerRadius="10" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="12">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
          <DataGrid ItemsSource="{Binding FilteredFlags}"
                    SelectedItem="{Binding SelectedFlag, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    RowHeight="44">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="48">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FlagEntryViewModel">
                    <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Color}" HorizontalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
              <DataGridTemplateColumn Header="Location" Width="1.4*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FlagEntryViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding Coordinate}" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                      <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Active" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FlagEntryViewModel">
                    <ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}" HorizontalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Jump to" Command="{Binding JumpToSelectedCommand}" MinWidth="100"/>
            <Button Content="Remove" Command="{Binding DeleteSelectedCommand}" MinWidth="100"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
