<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="Aog.UI.Avalonia.Views.FieldOperations.ShiftPositionDialog"
        x:DataType="vm:ShiftPositionDialogViewModel"
        Title="Shift position"
        Width="520"
        Height="420"
        MinWidth="460"
        MinHeight="360"
        mc:Ignorable="d">
  <Grid Margin="20" RowDefinitions="Auto,*">
    <StackPanel>
      <TextBlock Text="Shift position" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="Manually offset the vehicle pose for alignment checks." Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*">
      <Border Padding="16" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="12">
          <TextBlock Text="Offsets" FontSize="18" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="East (m)" VerticalAlignment="Center"/>
            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding OffsetEastMeters, Mode=TwoWay}" Increment="0.05" FormatString="F2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="North (m)" VerticalAlignment="Center"/>
            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OffsetNorthMeters, Mode=TwoWay}" Increment="0.05" FormatString="F2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Heading (°)" VerticalAlignment="Center"/>
            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding HeadingOffsetDegrees, Mode=TwoWay}" Increment="0.1" FormatString="F2"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="↥" Command="{Binding NudgeNorthCommand}" Width="44"/>
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="↤" Command="{Binding NudgeWestCommand}" Width="44"/>
                <Button Content="↧" Command="{Binding NudgeSouthCommand}" Width="44"/>
                <Button Content="↦" Command="{Binding NudgeEastCommand}" Width="44"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="⟲" Command="{Binding RotateLeftCommand}" Width="44"/>
            <Button Content="⟳" Command="{Binding RotateRightCommand}" Width="44"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Reset" Command="{Binding ResetCommand}" MinWidth="100"/>
            <Button Content="Apply" Command="{Binding ApplyCommand}" MinWidth="120"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="16" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="12">
          <TextBlock Text="Last applied" FontSize="18" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="East (m)" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppliedEastMeters, StringFormat={}{0:F2}}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="North (m)" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppliedNorthMeters, StringFormat={}{0:F2}}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Heading (°)" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppliedHeadingDegrees, StringFormat={}{0:F2}}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last applied" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastApplied, StringFormat={}{0:G}}"/>
          </Grid>
          <Border Padding="12" CornerRadius="10" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ApplicationCount, StringFormat={}{0} applications}" FontSize="12" Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
