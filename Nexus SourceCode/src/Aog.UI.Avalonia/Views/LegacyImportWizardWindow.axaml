<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        xmlns:styling="clr-namespace:Avalonia.Styling;assembly=Avalonia.Styling"
        x:Class="Aog.UI.Avalonia.LegacyImportWizardWindow"
        x:DataType="vm:LegacyImportWizardViewModel"
        Title="Legacy guidance import"
        Width="720"
        Height="520"
        mc:Ignorable="d">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="8">
      <TextBlock Text="Legacy guidance import" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="Import legacy AB lines and boundary shapes, then route their telemetry into the Nexus core." TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Field name" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding FieldName, Mode=TwoWay}"/>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="AB lines CSV" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding AbLineCsvPath}" IsReadOnly="True"/>
        <Button Grid.Column="2" Content="Browse..." Padding="12,4" Click="OnBrowseAbLines"/>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Boundary shapefile" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding BoundaryShapePath}" IsReadOnly="True"/>
        <Button Grid.Column="2" Content="Browse..." Padding="12,4" Click="OnBrowseBoundary"/>
      </Grid>

      <Border Grid.Row="3" Padding="16" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Text="Boundary summary" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="{Binding BoundarySummary}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Text="AB lines" FontWeight="SemiBold"/>
          <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding AbLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LegacyAbLineSummaryViewModel">
                  <Border Padding="8" Margin="0,0,0,8" Background="#05000000" BorderBrush="#12000000" BorderThickness="1" CornerRadius="4">
                    <Grid ColumnDefinitions="2*,Auto,Auto">
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Grid.Column="1" Text="{Binding LengthDisplay}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding HeadingDisplay}" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
        </TextBlock>

        <Button Grid.Column="1"
                Content="Import"
                Padding="16,6"
                HorizontalAlignment="Right"
                IsEnabled="{Binding CanImport}"
                Click="OnImport"/>
        <Button Grid.Column="2"
                Content="Apply routes"
                Padding="16,6"
                HorizontalAlignment="Right"
                IsEnabled="{Binding CanApply}"
                Click="OnApply"/>
      </Grid>
    </Border>
  </Grid>
</Window>
