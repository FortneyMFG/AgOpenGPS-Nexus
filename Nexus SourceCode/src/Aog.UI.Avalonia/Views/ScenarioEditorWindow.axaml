<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
        x:Class="Aog.UI.Avalonia.ScenarioEditorWindow"
        x:DataType="vm:ScenarioEditorViewModel"
        Title="Scenario editor"
        Width="840"
        Height="560"
        mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <TextBlock Text="Scenario editor" FontSize="24" FontWeight="Bold"/>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <StackPanel>
        <TextBlock Text="Scenarios" FontWeight="SemiBold"/>
        <ListBox ItemsSource="{Binding Scenarios}"
                 SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                 Height="340">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ScenarioDefinitionViewModel">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="Add" Command="{Binding AddScenarioCommand}" MinWidth="80"/>
          <Button Content="Remove" Command="{Binding RemoveScenarioCommand}" MinWidth="80"/>
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="1" Padding="16" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1">
        <ContentControl Content="{Binding SelectedScenario}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ScenarioDefinitionViewModel">
              <ScrollViewer>
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Scenario identifier" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ScenarioId, Mode=TwoWay}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Description" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Routes" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Routes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SimulationStreamRouteViewModel">
                          <Grid ColumnDefinitions="2*,2*,1*" Margin="0,4">
                            <TextBlock Text="{Binding Stream}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableSources}"
                                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                      MinWidth="160"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding AvailableModes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                      MinWidth="120"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Options" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Seed" VerticalAlignment="Center"/>
                      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Options.SeedText, Mode=TwoWay}"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Time scale" VerticalAlignment="Center"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Options.TimeScaleText, Mode=TwoWay}"/>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12" Background="#0F000000" BorderBrush="#19000000" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
        </TextBlock>

        <Button Grid.Column="1" Content="Save..." Click="OnSaveScenario" MinWidth="100"/>
        <Button Grid.Column="2" Content="Load..." Click="OnLoadScenario" MinWidth="100"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Content="Apply" Command="{Binding ApplyScenarioCommand}" MinWidth="90"/>
          <Button Content="Use defaults" Command="{Binding UseDefaultsCommand}" MinWidth="110"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
