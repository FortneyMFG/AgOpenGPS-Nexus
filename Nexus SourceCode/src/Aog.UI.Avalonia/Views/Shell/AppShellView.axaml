<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels.Shell"
             xmlns:workspace="clr-namespace:Aog.UI.Avalonia.ViewModels"
             xmlns:mapping="clr-namespace:Aog.UI.Avalonia.Views.Mapping"
             xmlns:controls="clr-namespace:Aog.UI.Avalonia.Controls"
             xmlns:rendering="clr-namespace:Aog.UI.Avalonia.Rendering"
             mc:Ignorable="d"
             x:Class="Aog.UI.Avalonia.Views.Shell.AppShellView"
             x:DataType="vm:AppShellViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720">
  <UserControl.Resources>
    <ResourceDictionary>
      <rendering:LockStateToBitmapConverter x:Key="LockStateIconConverter" />
      <rendering:LockStateToTextConverter x:Key="LockTooltipConverter" />
      <rendering:LockStateToActionTextConverter x:Key="LockActionTextConverter" />
      <rendering:BooleanToValueConverter x:Key="LockStateToGridOpacityConverter"
                                         TrueValue="0"
                                         FalseValue="0.82" />

      <DataTemplate x:Key="ShellMenuItemTemplate"
                    x:DataType="workspace:ShellMenuItemViewModel">
        <MenuItem Header="{Binding Header}"
                  Command="{Binding Command}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tooltip}"
                  ItemsSource="{Binding Children}">
          <MenuItem.ItemTemplate>
            <StaticResource ResourceKey="ShellMenuItemTemplate" />
          </MenuItem.ItemTemplate>
        </MenuItem>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="workspace:MappingWorkspaceViewModel">
      <mapping:MappingWorkspaceView />
    </DataTemplate>
    <DataTemplate x:DataType="workspace:BoundaryToolViewModel">
      <controls:BoundaryViewControl />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Menu.menu-bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Menu.menu-bar > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,28,0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="{DynamicResource ThemeFontSizeSm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Menu.menu-bar > MenuItem:pointerover">
      <Setter Property="Background" Value="#393939" />
    </Style>

    <Style Selector="ToggleButton.field-block">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Background="#2A2A2ACC"
                    BorderBrush="#555555"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="10"
                    Width="140"
                    Height="100">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#3A3A3A" />
                  <GradientStop Offset="1" Color="#2A2A2A" />
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style Selector="ToggleButton.field-block:pointerover">
      <Setter Property="Opacity" Value="0.95" />
    </Style>

    <Style Selector="ToggleButton.field-block:checked">
      <Setter Property="BorderBrush" Value="#0A6AD9" />
    </Style>

    <Style Selector="Button.menu-block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="#282828" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="#3F3F3F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="{DynamicResource ThemeFontSizeSm}" />
    </Style>

    <Style Selector="Button.menu-block:last-child">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.menu-block:pointerover">
      <Setter Property="Background" Value="#3A3A3A" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="#111111">
      <Border Grid.Row="0"
              Background="#2A2A2A"
              BorderBrush="#444444"
              BorderThickness="0,0,0,1"
              Padding="20,0">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Height="40"
              VerticalAlignment="Center">
        <Menu Grid.Column="0"
              Classes="menu-bar">
          <MenuItem Header="{Binding Host.ShellMenuBar.FileMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.FileMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.EditMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.EditMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.ViewMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.ViewMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.SettingsMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.SettingsMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.ServicesMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.ServicesMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.HelpMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.HelpMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
        </Menu>

        <Border Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
          <Button Command="{Binding ToggleLayoutLockCommand}"
                  Background="#4A4A4A"
                  BorderBrush="#666666"
                  BorderThickness="1"
                  Padding="10,5"
                  CornerRadius="6"
                  Foreground="#FFFFFF"
                  ToolTip.Tip="{Binding Layout.IsLocked, Converter={StaticResource LockTooltipConverter}}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
              <Image Source="{Binding Layout.IsLocked, Converter={StaticResource LockStateIconConverter}}"
                     Width="16"
                     Height="16" />
              <TextBlock Text="{Binding Layout.IsLocked, Converter={StaticResource LockActionTextConverter}}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Background="#101010">
      <Border HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Opacity="{Binding Layout.IsLocked, Converter={StaticResource LockStateToGridOpacityConverter}}">
          <Border.Background>
            <DrawingBrush TileMode="Tile"
                          Stretch="None"
                          AlignmentX="Left"
                          AlignmentY="Top">
              <DrawingBrush.Drawing>
                <DrawingGroup>
                  <GeometryDrawing Brush="#1FFFFFFF">
                    <GeometryDrawing.Geometry>
                      <RectangleGeometry Rect="0,0,40,40" />
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                  <GeometryDrawing>
                    <GeometryDrawing.Pen>
                      <Pen Brush="#33FFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                      <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                      </GeometryGroup>
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingGroup>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Border.Background>
      </Border>

      <Border Margin="80,40,40,40"
              Background="#1F1F1FCC"
              BorderBrush="#555555"
              BorderThickness="2"
              CornerRadius="12"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="#2E2E2E" />
            <GradientStop Offset="1" Color="#1A1A1A" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <TextBlock Text="Main Display Panel"
                     Margin="16"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="#CCCCCC"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top" />
          <ContentControl Content="{Binding MainContent}"
                          Margin="16,40,16,16" />
        </Grid>
      </Border>

      <ToggleButton x:Name="FieldSettingsToggle"
                    Classes="field-block"
                    IsChecked="{Binding IsFieldMenuOpen, Mode=TwoWay}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="40,0,0,40">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
          <Border Background="#626262"
                  BorderBrush="#777777"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="4"
                  Width="32"
                  Height="32">
            <TextBlock Text="⚙"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Field Settings"
                     FontWeight="SemiBold"
                     Foreground="#E0E0E0"
                     TextAlignment="Center" />
        </StackPanel>
      </ToggleButton>

        <Popup x:Name="FieldSettingsMenu"
               PlacementTarget="{Binding #FieldSettingsToggle}"
               Placement="Right"
               VerticalOffset="-20"
               IsOpen="{Binding IsFieldMenuOpen, Mode=TwoWay}"
               IsLightDismissEnabled="True"
               Closed="OnFieldSettingsMenuClosed">
        <Border Background="#1E1E1E"
                BorderBrush="#555555"
                BorderThickness="2"
                CornerRadius="10"
                Padding="12"
                MaxHeight="400">
          <StackPanel Width="220"
                      Spacing="10">
            <TextBlock Text="Field Settings"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#CCCCCC" />
            <ItemsControl ItemsSource="{Binding FieldSettingsCategory.Blocks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockLauncherItemViewModel">
                  <Button Classes="menu-block"
                          Command="{Binding LaunchCommand}"
                          Click="OnFieldSettingsMenuItemClick">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
