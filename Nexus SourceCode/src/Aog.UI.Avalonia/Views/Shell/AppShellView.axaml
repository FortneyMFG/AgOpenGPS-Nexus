<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels.Shell"
             xmlns:workspace="clr-namespace:Aog.UI.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Aog.UI.Avalonia.Controls"
             xmlns:rendering="clr-namespace:Aog.UI.Avalonia.Rendering"
             xmlns:shell="clr-namespace:Aog.UI.Avalonia.Views.Shell"
             xmlns:mapping="clr-namespace:Aog.UI.Avalonia.Views.Mapping"
             xmlns:field="clr-namespace:Aog.UI.Avalonia.Views.Field"
             xmlns:layout="clr-namespace:Aog.UI.Avalonia.Layout"
             mc:Ignorable="d"
             x:Class="Aog.UI.Avalonia.Views.Shell.AppShellView"
             x:DataType="vm:AppShellViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720">
  <UserControl.Resources>
    <ResourceDictionary>
      <rendering:IconKeyToBitmapConverter x:Key="BlockIconConverter" />
      <rendering:LockStateToBitmapConverter x:Key="LockStateIconConverter" />
      <rendering:LockStateToTextConverter x:Key="LockTooltipConverter" />
      <rendering:LockStateToActionTextConverter x:Key="LockActionTextConverter" />
      <rendering:SpacingToThicknessConverter x:Key="SpacingToThicknessConverter" />
      <rendering:BooleanNegationConverter x:Key="BooleanNegationConverter" />
      <rendering:BlockSettingsVisibilityConverter x:Key="BlockSettingsVisibilityConverter" />
      <rendering:StringHasValueConverter x:Key="StringHasValueConverter" />

      <DataTemplate x:Key="ShellMenuItemTemplate"
                    x:DataType="workspace:ShellMenuItemViewModel">
        <MenuItem Header="{Binding Header}"
                  Command="{Binding Command}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tooltip}"
                  ItemsSource="{Binding Children}">
          <MenuItem.ItemTemplate>
            <StaticResource ResourceKey="ShellMenuItemTemplate" />
          </MenuItem.ItemTemplate>
        </MenuItem>
      </DataTemplate>

      <DataTemplate x:Key="ToolbarItemTemplate"
                    x:DataType="workspace:TopToolbarItemViewModel">
        <Button Command="{Binding Command}"
                ToolTip.Tip="{Binding Tooltip}"
                Classes.toolbar="True"
                Classes.toggle="{Binding IsToggle}"
                Classes.active="{Binding IsChecked}">
          <TextBlock Text="{Binding DisplayName}" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="PanelVisualTemplate"
                    x:DataType="layout:PanelVisual">
        <Border Background="#2A2A2ACC"
                BorderBrush="#565656"
                BorderThickness="2"
                CornerRadius="12"
                Opacity="0.92"
                Width="{Binding Bounds.Width}"
                Height="{Binding Bounds.Height}"
                Canvas.Left="{Binding Bounds.X}"
                Canvas.Top="{Binding Bounds.Y}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
              <GradientStop Offset="0" Color="#1C1C1CEE" />
              <GradientStop Offset="1" Color="#2E2E2EFF" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="BlockTileTemplate"
                    x:DataType="vm:BlockItemViewModel">
        <controls:BlockTileButton Command="{Binding InvokeCommand}"
                                  ToolTip.Tip="{Binding Label}"
                                  Classes.block-tile="True"
                                  controls:TiledPanel.Row="{Binding Tile.Row}"
                                  controls:TiledPanel.Column="{Binding Tile.Col}"
                                  controls:TiledPanel.RowSpan="{Binding Tile.RowSpan}"
                                  controls:TiledPanel.ColumnSpan="{Binding Tile.ColSpan}">
          <Grid>
            <Border CornerRadius="10"
                    Background="#1F1F1FCC"
                    BorderBrush="#525252"
                    BorderThickness="2"
                    Opacity="0.94">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                  <GradientStop Offset="0" Color="#2F2F2FF0" />
                  <GradientStop Offset="1" Color="#1E1E1EE6" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Menu Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0">
                <Menu.IsVisible>
                  <MultiBinding Converter="{StaticResource BlockSettingsVisibilityConverter}">
                    <Binding Path="HasSettings" />
                    <Binding Path="IsLayoutLocked" />
                  </MultiBinding>
                </Menu.IsVisible>
                <MenuItem ItemsSource="{Binding SizeOptions}"
                          ToolTip.Tip="Adjust block size">
                  <MenuItem.Header>
                    <Border Background="#626262"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2"
                            Margin="2">
                      <TextBlock Text="⚙"
                                 FontSize="12"
                                 FontWeight="Bold" />
                    </Border>
                  </MenuItem.Header>
                  <MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlockSizeOptionViewModel">
                      <MenuItem Header="{Binding Label}"
                                Command="{Binding ApplyCommand}"
                                ToggleType="CheckBox"
                                IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                  </MenuItem.ItemTemplate>
                </MenuItem>
              </Menu>

              <StackPanel Grid.Row="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="6">
                <Image Source="{Binding IconKey, Converter={StaticResource BlockIconConverter}}"
                       Width="36"
                       Height="36"
                       Stretch="Uniform"
                       IsVisible="{Binding IconKey, Converter={StaticResource StringHasValueConverter}}" />
                <TextBlock Text="{Binding Label}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#E0E0E0" />
              </StackPanel>
            </Grid>
          </Grid>
        </controls:BlockTileButton>
      </DataTemplate>

      <DataTemplate x:Key="FloatingPanelOverlayTemplate"
                    x:DataType="vm:FloatingPanelViewModel">
        <shell:FloatingPanelOverlay Width="{Binding Bounds.Width}"
                                    Height="{Binding Bounds.Height}"
                                    Canvas.Left="{Binding Bounds.X}"
                                    Canvas.Top="{Binding Bounds.Y}" />
      </DataTemplate>

      <DataTemplate x:Key="FloatingBlockOverlayTemplate"
                    x:DataType="vm:FloatingBlockViewModel">
        <shell:FloatingBlockOverlay Width="{Binding Bounds.Width}"
                                    Height="{Binding Bounds.Height}"
                                    Canvas.Left="{Binding Bounds.X}"
                                    Canvas.Top="{Binding Bounds.Y}" />
      </DataTemplate>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="workspace:MappingWorkspaceViewModel">
      <mapping:MappingWorkspaceView />
    </DataTemplate>
    <DataTemplate x:DataType="workspace:BoundaryToolViewModel">
      <controls:BoundaryViewControl />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Menu.menu-bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Menu.menu-bar > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,28,0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="{DynamicResource ThemeFontSizeSm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Menu.menu-bar > MenuItem:pointerover">
      <Setter Property="Background" Value="#393939" />
    </Style>

    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="#383838" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#545454" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource ThemeFontSizeSm}" />
    </Style>

    <Style Selector="Button.toolbar:hover">
      <Setter Property="Background" Value="#4A4A4A" />
    </Style>

    <Style Selector="Button.toolbar.active">
      <Setter Property="Background" Value="#0A6AD9" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.block-tile">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.block-tile:hover">
      <Setter Property="Opacity" Value="0.96" />
    </Style>

    <Style Selector="Button.block-tile:pressed">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style Selector="ToggleButton.layout-lock">
      <Setter Property="Background" Value="#4A4A4A" />
      <Setter Property="BorderBrush" Value="#666666" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.layout-lock:hover">
      <Setter Property="Background" Value="#595959" />
    </Style>

    <Style Selector="ToggleButton.layout-lock:checked">
      <Setter Property="Background" Value="#0A6AD9" />
      <Setter Property="BorderBrush" Value="#0A6AD9" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto"
        Background="#111111">
    <Border Grid.Row="0"
            Background="Transparent">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
          <GradientStop Offset="0" Color="#222222" />
          <GradientStop Offset="1" Color="#2E2E2E" />
        </LinearGradientBrush>
      </Border.Background>
      <Border BorderBrush="#3E3E3E"
              BorderThickness="0,0,0,1"
              Padding="20,10">
        <Grid ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="24"
              RowSpacing="8">
          <Menu Grid.Row="0"
                Grid.Column="0"
                Classes="menu-bar">
            <MenuItem Header="{Binding Host.ShellMenuBar.FileMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.FileMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="{Binding Host.ShellMenuBar.FieldMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.FieldMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="{Binding Host.ShellMenuBar.ToolsMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.ToolsMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="{Binding Host.ShellMenuBar.SettingsMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.SettingsMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="{Binding Host.ShellMenuBar.ServicesMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.ServicesMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="{Binding Host.ShellMenuBar.PluginsMenu.Header}"
                      ItemsSource="{Binding Host.ShellMenuBar.PluginsMenu.Items}">
              <MenuItem.ItemTemplate>
                <StaticResource ResourceKey="ShellMenuItemTemplate" />
              </MenuItem.ItemTemplate>
            </MenuItem>
          </Menu>

          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
            <Border Background="#353535"
                    BorderBrush="#545454"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,5">
              <TextBlock Text="AgOpenGPS"
                         FontWeight="Bold"
                         Foreground="#FFFFFF"
                         FontSize="{DynamicResource ThemeFontSizeMd}" />
            </Border>
            <TextBlock Text="Nexus"
                       FontSize="{DynamicResource ThemeFontSizeMd}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="#9AD0FF" />
          </StackPanel>

          <StackPanel Grid.Row="0"
                      Grid.Column="2"
                      Orientation="Vertical"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="6">
            <ToggleButton Classes="layout-lock"
                          IsChecked="{Binding Layout.IsLocked}"
                          ToolTip.Tip="{Binding Layout.IsLocked, Converter={StaticResource LockTooltipConverter}}"
                          Content="{Binding Layout.IsLocked, Converter={StaticResource LockActionTextConverter}}" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#CCCCCC"
                       FontSize="{DynamicResource ThemeFontSizeSm}"
                       TextAlignment="Right" />
          </StackPanel>

          <ItemsControl Grid.Row="1"
                        Grid.ColumnSpan="3"
                        ItemsSource="{Binding Host.TopToolbar.Items}"
                        ItemTemplate="{StaticResource ToolbarItemTemplate}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding Host.IsTopToolbarVisible, FallbackValue=False}">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl">
                <Setter Property="ItemsPanel">
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                  </ItemsPanelTemplate>
                </Setter>
              </Style>
            </ItemsControl.Styles>
          </ItemsControl>
        </Grid>
      </Border>
    </Border>

    <Grid Grid.Row="1"
          x:Name="WorkspaceRoot"
          Background="#101010">
      <Canvas x:Name="LayoutCanvas"
              Width="{Binding #WorkspaceRoot.Bounds.Width}"
              Height="{Binding #WorkspaceRoot.Bounds.Height}"
              ZIndex="1"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnWorkspaceDragOver"
              DragDrop.Drop="OnWorkspaceDrop">
        <ContentControl Content="{Binding MainContent}"
                        Width="{Binding #WorkspaceRoot.Bounds.Width}"
                        Height="{Binding #WorkspaceRoot.Bounds.Height}"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        ZIndex="0" />

        <controls:PaneCanvas Layout="{Binding Layout.Grid}"
                             LayoutResult="{Binding Layout.PaneLayout}"
                             ShowMinorGrid="{Binding Layout.IsLocked, Converter={StaticResource BooleanNegationConverter}}"
                             Width="{Binding #WorkspaceRoot.Bounds.Width}"
                             Height="{Binding #WorkspaceRoot.Bounds.Height}"
                             Canvas.Left="0"
                             Canvas.Top="0"
                             ZIndex="0"
                             IsHitTestVisible="False"
                             Opacity="0.82" />

        <ItemsControl x:Name="PanelVisuals"
                      ItemsSource="{Binding Layout.PaneLayout.Panels}"
                      ItemTemplate="{StaticResource PanelVisualTemplate}"
                      Width="{Binding #WorkspaceRoot.Bounds.Width}"
                      Height="{Binding #WorkspaceRoot.Bounds.Height}"
                      IsHitTestVisible="False"
                      ZIndex="1">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="BlockTiles"
                      ItemsSource="{Binding Layout.Blocks}"
                      ItemTemplate="{StaticResource BlockTileTemplate}"
                      Background="Transparent"
                      Margin="{Binding Layout.WorkspaceLayout, Converter={StaticResource SpacingToThicknessConverter}}"
                      Width="{Binding #WorkspaceRoot.Bounds.Width}"
                      Height="{Binding #WorkspaceRoot.Bounds.Height}"
                      SizeChanged="OnViewportSizeChanged"
                      Canvas.Left="0"
                      Canvas.Top="0"
                      ZIndex="2">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:TiledPanel Layout="{Binding Layout.Grid}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="FloatingPanelOverlays"
                      ItemsSource="{Binding Layout.FloatingPanels}"
                      ItemTemplate="{StaticResource FloatingPanelOverlayTemplate}"
                      Width="{Binding #WorkspaceRoot.Bounds.Width}"
                      Height="{Binding #WorkspaceRoot.Bounds.Height}"
                      Canvas.Left="0"
                      Canvas.Top="0"
                      ZIndex="5"
                      IsVisible="{Binding Layout.AreFloatingOverlaysVisible}"
                      IsHitTestVisible="{Binding Layout.AreFloatingOverlaysVisible}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="FloatingBlockOverlays"
                      ItemsSource="{Binding Layout.FloatingBlocks}"
                      ItemTemplate="{StaticResource FloatingBlockOverlayTemplate}"
                      Width="{Binding #WorkspaceRoot.Bounds.Width}"
                      Height="{Binding #WorkspaceRoot.Bounds.Height}"
                      Canvas.Left="0"
                      Canvas.Top="0"
                      ZIndex="5"
                      IsVisible="{Binding Layout.AreFloatingOverlaysVisible}"
                      IsHitTestVisible="{Binding Layout.AreFloatingOverlaysVisible}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Canvas>

      <field:FieldSettingsDock DataContext="{Binding Layout}"
                               ZIndex="6" />
    </Grid>

    <Border Grid.Row="2"
            Background="#202020"
            BorderBrush="#333333"
            BorderThickness="1,1,1,0"
            Padding="16,8">
      <shell:StatusStripView DataContext="{Binding StatusStrip}" />
    </Border>
  </Grid>
</UserControl>
