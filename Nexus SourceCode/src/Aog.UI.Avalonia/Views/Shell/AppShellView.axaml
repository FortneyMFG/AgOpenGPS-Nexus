<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels.Shell"
             xmlns:workspace="clr-namespace:Aog.UI.Avalonia.ViewModels"
             xmlns:controls="clr-namespace:Aog.UI.Avalonia.Controls"
             xmlns:model="clr-namespace:Aog.UI.Avalonia.Models"
             xmlns:mapping="clr-namespace:Aog.UI.Avalonia.Views.Mapping"
             xmlns:rendering="clr-namespace:Aog.UI.Avalonia.Rendering"
             mc:Ignorable="d"
             x:Class="Aog.UI.Avalonia.Views.Shell.AppShellView"
             x:DataType="vm:AppShellViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720">
  <UserControl.Resources>
    <ResourceDictionary>
      <rendering:IconKeyToBitmapConverter x:Key="BlockIconConverter" />
      <rendering:LockStateToBitmapConverter x:Key="LockStateIconConverter" />
      <rendering:LockStateToTextConverter x:Key="LockTooltipConverter" />
      <rendering:BlockTileSizeConverter x:Key="BlockTileSizeConverter" />
      <rendering:SidebarDimensionConverter x:Key="SidebarDimensionConverter" />
      <rendering:BooleanNegationConverter x:Key="BooleanNegationConverter" />
      <rendering:SpacingToThicknessConverter x:Key="SpacingToThicknessConverter" />

      <DataTemplate x:Key="ShellMenuItemTemplate"
                    x:DataType="workspace:ShellMenuItemViewModel">
        <MenuItem Header="{Binding Header}"
                  Command="{Binding Command}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tooltip}"
                  ItemsSource="{Binding Children}">
          <MenuItem.ItemTemplate>
            <StaticResource ResourceKey="ShellMenuItemTemplate" />
          </MenuItem.ItemTemplate>
        </MenuItem>
      </DataTemplate>

      <DataTemplate x:Key="ToolbarItemTemplate"
                    x:DataType="workspace:TopToolbarItemViewModel">
        <Button Command="{Binding Command}"
                ToolTip.Tip="{Binding Tooltip}"
                Classes.toolbar="True"
                Classes.toggle="{Binding IsToggle}"
                Classes.active="{Binding IsChecked}">
          <TextBlock Text="{Binding DisplayName}" />
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="VerticalBlockTemplate"
                    x:DataType="vm:BlockItemViewModel">
        <Button Command="{Binding InvokeCommand}"
                ToolTip.Tip="{Binding Label}"
                Classes.sidebar="True"
                Classes.vertical="True">
          <Button.Width>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.Width>
          <Button.MinWidth>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MinWidth>
          <Button.MaxWidth>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MaxWidth>
          <Button.Height>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.Height>
          <Button.MinHeight>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MinHeight>
          <Button.MaxHeight>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MaxHeight>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
              <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
              <Separator />
              <MenuItem Header="Move to left" Command="{Binding MoveToLeftCommand}" />
              <MenuItem Header="Move to right" Command="{Binding MoveToRightCommand}" />
              <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" />
              <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" />
              <Separator />
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="4">
            <Image Source="{Binding IconKey, Converter={StaticResource BlockIconConverter}}"
                   Width="32"
                   Height="32"
                   Stretch="Uniform" />
            <TextBlock Text="{Binding Label}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="HorizontalBlockTemplate"
                    x:DataType="vm:BlockItemViewModel">
        <Button Command="{Binding InvokeCommand}"
                ToolTip.Tip="{Binding Label}"
                Classes.sidebar="True"
                Classes.bottom="True">
          <Button.Width>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.Width>
          <Button.MinWidth>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MinWidth>
          <Button.MaxWidth>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MaxWidth>
          <Button.Height>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.Height>
          <Button.MinHeight>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MinHeight>
          <Button.MaxHeight>
            <MultiBinding Converter="{StaticResource BlockTileSizeConverter}" ConverterParameter="Height">
              <Binding />
              <Binding Path="Tag"
                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
            </MultiBinding>
          </Button.MaxHeight>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Move left" Command="{Binding MoveToLeftCommand}" />
              <MenuItem Header="Move right" Command="{Binding MoveToRightCommand}" />
              <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" />
              <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" />
              <Separator />
              <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
              <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
              <Separator />
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <Image Source="{Binding IconKey, Converter={StaticResource BlockIconConverter}}"
                   Width="28"
                   Height="28"
                   Stretch="Uniform" />
            <TextBlock Text="{Binding Label}" />
          </StackPanel>
        </Button>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="workspace:MappingWorkspaceViewModel">
      <mapping:MappingWorkspaceView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="{DynamicResource ShellChromeBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="Padding" Value="{DynamicResource ShellToolbarButtonPadding}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeRadiusSm}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource ThemeFontSizeSm}" />
    </Style>

    <Style Selector="Button.toolbar:hover">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <Style Selector="Button.toolbar.active">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.sidebar">
      <Setter Property="Background" Value="{DynamicResource ShellChromeBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeRadiusSm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Button.sidebar:hover">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentMutedBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.sidebar:pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="Button.sidebar.vertical">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.sidebar.bottom">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="ToggleButton.layout-lock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <Style Selector="ToggleButton.layout-lock:hover">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentMutedBrush}" />
    </Style>

    <Style Selector="ToggleButton.layout-lock:checked">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.layout-lock Image">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="ToggleButton.layout-lock:checked Image">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="workspace:BoundaryToolViewModel">
      <controls:BoundaryViewControl />
    </DataTemplate>

  </UserControl.DataTemplates>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ShellChromeBackgroundBrush}"
            BorderBrush="{DynamicResource ShellChromeBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource ShellChromePadding}">
      <StackPanel Spacing="{DynamicResource ThemeSpacingSm}">
        <Menu Background="Transparent">
          <MenuItem Header="{Binding Host.ShellMenuBar.FileMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.FileMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.FieldMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.FieldMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.ToolsMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.ToolsMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.SettingsMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.SettingsMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.ServicesMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.ServicesMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
          <MenuItem Header="{Binding Host.ShellMenuBar.PluginsMenu.Header}"
                    ItemsSource="{Binding Host.ShellMenuBar.PluginsMenu.Items}">
            <MenuItem.ItemTemplate>
              <StaticResource ResourceKey="ShellMenuItemTemplate" />
            </MenuItem.ItemTemplate>
          </MenuItem>
        </Menu>

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{DynamicResource ThemeSpacingLg}"
              VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource ThemeSpacingSm}"
                      VerticalAlignment="Center">
            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ShellChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ThemeRadiusSm}"
                    Padding="8,4">
              <TextBlock Text="AgOpenGPS"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ThemeForegroundBrush}"
                         FontSize="{DynamicResource ThemeFontSizeLg}" />
            </Border>
            <TextBlock Text="Nexus"
                       FontSize="{DynamicResource ThemeFontSizeLg}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeAccentMutedBrush}" />
          </StackPanel>

          <ItemsControl Grid.Column="1"
                        ItemsSource="{Binding Host.TopToolbar.Items}"
                        ItemTemplate="{StaticResource ToolbarItemTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="{DynamicResource ThemeSpacingSm}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="8">
            <ToggleButton Classes="layout-lock"
                          IsChecked="{Binding Layout.IsLocked}"
                          ToolTip.Tip="{Binding Layout.IsLocked, Converter={StaticResource LockTooltipConverter}}">
              <Image Source="{Binding Layout.IsLocked, Converter={StaticResource LockStateIconConverter}}"
                     Width="20"
                     Height="20"
                     Stretch="Uniform" />
            </ToggleButton>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource ThemeAccentMutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,8,0,0"
              HorizontalAlignment="Stretch"
              Height="{Binding Layout.TopSidebarSettings, Converter={StaticResource SidebarDimensionConverter}, ConverterParameter=Height}">
          <controls:SidebarGridOverlay LayoutSettings="{Binding Layout.TopSidebarSettings}"
                                       IsVisible="{Binding Layout.IsLocked, Converter={StaticResource BooleanNegationConverter}}"
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
          <ItemsControl x:Name="TopBlocksControl"
                        ItemsSource="{Binding Layout.TopBlocks}"
                        ItemTemplate="{StaticResource HorizontalBlockTemplate}"
                        Tag="{Binding Layout.TopSidebarSettings.Spacing}"
                        HorizontalAlignment="Center"
                        DragDrop.AllowDrop="True">
            <ItemsControl.Styles>
              <Style Selector="#TopBlocksControl > ContentPresenter">
                <Setter Property="Margin"
                        Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource SpacingToThicknessConverter}}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ShellChromeBackgroundBrush}"
            BorderBrush="{DynamicResource ShellChromeBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,6"
            Height="{Binding Layout.BottomSidebarSettings, Converter={StaticResource SidebarDimensionConverter}, ConverterParameter=Height}">
      <Grid>
        <controls:SidebarGridOverlay LayoutSettings="{Binding Layout.BottomSidebarSettings}"
                                     IsVisible="{Binding Layout.IsLocked, Converter={StaticResource BooleanNegationConverter}}"
                                     IsHitTestVisible="False"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
        <ItemsControl x:Name="BottomBlocksControl"
                      ItemsSource="{Binding Layout.BottomBlocks}"
                      ItemTemplate="{StaticResource HorizontalBlockTemplate}"
                      Tag="{Binding Layout.BottomSidebarSettings.Spacing}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      DragDrop.AllowDrop="True">
          <ItemsControl.Styles>
            <Style Selector="#BottomBlocksControl > ContentPresenter">
              <Setter Property="Margin"
                      Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource SpacingToThicknessConverter}}" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"
                         HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Margin="12,12,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource ShellChromeBackgroundBrush}"
              BorderBrush="{DynamicResource ShellChromeBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ThemeRadiusMd}"
              Padding="8"
              Margin="0,0,12,0"
              MinWidth="96"
              Width="{Binding Layout.LeftSidebarSettings, Converter={StaticResource SidebarDimensionConverter}, ConverterParameter=Width}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <controls:SidebarGridOverlay LayoutSettings="{Binding Layout.LeftSidebarSettings}"
                                         IsVisible="{Binding Layout.IsLocked, Converter={StaticResource BooleanNegationConverter}}"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
            <ItemsControl x:Name="LeftBlocksControl"
                          ItemsSource="{Binding Layout.LeftBlocks}"
                          ItemTemplate="{StaticResource VerticalBlockTemplate}"
                          Tag="{Binding Layout.LeftSidebarSettings.Spacing}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          DragDrop.AllowDrop="True">
              <ItemsControl.Styles>
                <Style Selector="#LeftBlocksControl > ContentPresenter">
                  <Setter Property="Margin"
                          Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource SpacingToThicknessConverter}}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Vertical"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource ShellPanelBackgroundBrush}"
              BorderBrush="{DynamicResource ShellPanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ThemeRadiusMd}"
              Padding="0"
              Margin="0,0,12,0">
        <Grid>
          <Border Background="{DynamicResource ThemeSurfaceAltBrush}"
                  CornerRadius="{DynamicResource ThemeRadiusMd}" />
          <ContentControl Margin="16"
                          Content="{Binding MainContent}" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource ShellChromeBackgroundBrush}"
              BorderBrush="{DynamicResource ShellChromeBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ThemeRadiusMd}"
              Padding="8"
              Margin="12,0,0,0"
              MinWidth="96"
              Width="{Binding Layout.RightSidebarSettings, Converter={StaticResource SidebarDimensionConverter}, ConverterParameter=Width}"
              IsVisible="{Binding Host.IsRightSidebarVisible}">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
          <controls:SidebarGridOverlay LayoutSettings="{Binding Layout.RightSidebarSettings}"
                                       IsVisible="{Binding Layout.IsLocked, Converter={StaticResource BooleanNegationConverter}}"
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
          <ItemsControl x:Name="RightBlocksControl"
                        ItemsSource="{Binding Layout.RightBlocks}"
                        ItemTemplate="{StaticResource VerticalBlockTemplate}"
                        Tag="{Binding Layout.RightSidebarSettings.Spacing}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        DragDrop.AllowDrop="True">
            <ItemsControl.Styles>
              <Style Selector="#RightBlocksControl > ContentPresenter">
                <Setter Property="Margin"
                        Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource SpacingToThicknessConverter}}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Vertical"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>



