<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Aog.UI.Avalonia.Views.Shell.EditPromptPanel"
             d:DesignWidth="360"
             d:DesignHeight="260">
  <UserControl.Styles>
    <Style Selector="Border.section-item">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="#3F3F3F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.section-item TextBlock.title">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.section-item TextBlock.chevron">
      <Setter Property="Foreground" Value="#9E9E9E" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.section-item:pointerover">
      <Setter Property="Background" Value="#3A3A3A" />
      <Setter Property="BorderBrush" Value="#4F8CE0" />
    </Style>
  </UserControl.Styles>

  <Border Background="#221E1E"
          CornerRadius="8"
          BorderBrush="#3B3B3B"
          BorderThickness="1">
    <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Classes="section-item">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" Text="General" />
              <TextBlock Classes="chevron" Text="›" Grid.Column="1" />
            </Grid>
          </Border>
          <Border Classes="section-item">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" Text="Display" />
              <TextBlock Classes="chevron" Text="›" Grid.Column="1" />
            </Grid>
          </Border>
          <Border Classes="section-item">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" Text="Controls" />
              <TextBlock Classes="chevron" Text="›" Grid.Column="1" />
            </Grid>
          </Border>
          <Border Classes="section-item">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" Text="Field" />
              <TextBlock Classes="chevron" Text="›" Grid.Column="1" />
            </Grid>
          </Border>
          <Border Classes="section-item">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="title" Text="GPS" />
              <TextBlock Classes="chevron" Text="›" Grid.Column="1" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="Choose a page on the left to edit its settings."
                     Foreground="#B0B0B0"
                     FontSize="13"
                     TextWrapping="Wrap" />
          <Border Background="#2A2A2A"
                  BorderBrush="#3B3B3B"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Theme"
                         Foreground="#E0E0E0"
                         FontWeight="SemiBold" />
              <TextBlock Text="Auto"
                         Foreground="#9DD2FF" />
            </StackPanel>
          </Border>
          <Border Background="#2A2A2A"
                  BorderBrush="#3B3B3B"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Units"
                         Foreground="#E0E0E0"
                         FontWeight="SemiBold" />
              <TextBlock Text="Metric"
                         Foreground="#9DD2FF" />
            </StackPanel>
          </Border>
          <Border Background="#2A2A2A"
                  BorderBrush="#3B3B3B"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Language"
                         Foreground="#E0E0E0"
                         FontWeight="SemiBold" />
              <TextBlock Text="English"
                         Foreground="#9DD2FF" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
