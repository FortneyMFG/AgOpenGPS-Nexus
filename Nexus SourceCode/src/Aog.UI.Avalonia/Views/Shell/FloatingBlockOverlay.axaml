<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels.Shell"
             xmlns:rendering="clr-namespace:Aog.UI.Avalonia.Rendering"
             mc:Ignorable="d"
             x:Class="Aog.UI.Avalonia.Views.Shell.FloatingBlockOverlay"
             x:DataType="vm:FloatingBlockViewModel"
             d:DesignWidth="200"
             d:DesignHeight="200">
  <UserControl.Resources>
    <rendering:BooleanNegationConverter x:Key="BooleanNegationConverter" />
    <rendering:BooleanToValueConverter x:Key="CollisionBorderBrushConverter"
                                       TrueValue="#FFDD5B5B" />
    <rendering:BooleanToValueConverter x:Key="CollisionBackgroundConverter"
                                       TrueValue="#40DD5B5B" />
    <rendering:BooleanToValueConverter x:Key="LockedOpacityConverter"
                                       TrueValue="0.75" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border#Outline">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeRadiusMd}" />
      <Setter Property="Background" Value="{DynamicResource FloatingBlockBackgroundBrush}" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>

    <Style Selector="Border.resize-handle">
      <Setter Property="Background" Value="#4F8CE0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderBrush" Value="#255A92" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Border.resize-handle.edge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Border.resize-handle.corner">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border x:Name="Outline"
            BorderBrush="{Binding IsColliding, Converter={StaticResource CollisionBorderBrushConverter}}"
            Background="{Binding IsColliding, Converter={StaticResource CollisionBackgroundConverter}}"
            Opacity="{Binding IsLocked, Converter={StaticResource LockedOpacityConverter}}"
            PointerPressed="OnDragPointerPressed"
            PointerReleased="OnPointerReleased"
            PointerMoved="OnPointerMoved"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#1A0C1626"
                Padding="8"
                CornerRadius="{DynamicResource ThemeRadiusSm}">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#F0F4F8" />
            <Button Command="{Binding OpenSettingsCommand}"
                    Width="24"
                    Height="24"
                    Padding="0"
                    Content="⚙"
                    Margin="8,0,0,0"
                    ToolTip.Tip="Adjust floating block"
                    IsEnabled="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <TextBlock Text="Drag to reposition"
                     Margin="6"
                     FontSize="11"
                     Foreground="#C0D6EB" />
        </Grid>
      </Grid>
    </Border>

    <Border Classes="resize-handle edge"
            Tag="Top"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="24,-4,24,0"
            Cursor="TopSide"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle edge"
            Tag="Bottom"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="24,0,24,-4"
            Cursor="BottomSide"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle edge"
            Tag="Left"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Left"
            Margin="-4,24,0,24"
            Cursor="LeftSide"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle edge"
            Tag="Right"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Right"
            Margin="0,24,-4,24"
            Cursor="RightSide"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle corner"
            Tag="TopLeft"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="-6,-6,0,0"
            Cursor="TopLeftCorner"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle corner"
            Tag="TopRight"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,-6,-6,0"
            Cursor="TopRightCorner"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle corner"
            Tag="BottomLeft"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="-6,0,0,-6"
            Cursor="BottomLeftCorner"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />

    <Border Classes="resize-handle corner"
            Tag="BottomRight"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,-6,-6"
            Cursor="BottomRightCorner"
            PointerPressed="OnResizeHandlePressed"
            PointerMoved="OnPointerMoved"
            PointerReleased="OnPointerReleased"
            PointerCaptureLost="OnPointerCaptureLost"
            IsHitTestVisible="{Binding IsLocked, Converter={StaticResource BooleanNegationConverter}}" />
  </Grid>
</UserControl>
