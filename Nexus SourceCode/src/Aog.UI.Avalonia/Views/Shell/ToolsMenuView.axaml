<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
          x:Class="Aog.UI.Avalonia.Views.Shell.ToolsMenuView"
          x:DataType="vm:ShellMenuGroupViewModel"
          Header="{Binding Header}">
  <MenuItem.ItemTemplate>
    <HierarchicalDataTemplate DataType="vm:ShellMenuItemViewModel" ItemsSource="{Binding Children}">
      <MenuItem Header="{Binding Header}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}">
        <MenuItem.ToolTip>
          <ToolTip Content="{Binding Tooltip}"/>
        </MenuItem.ToolTip>
      </MenuItem>
    </HierarchicalDataTemplate>
  </MenuItem.ItemTemplate>
</MenuItem>
