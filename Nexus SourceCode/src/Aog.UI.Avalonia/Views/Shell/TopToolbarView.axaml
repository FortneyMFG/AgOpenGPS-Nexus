<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aog.UI.Avalonia.ViewModels"
             x:Class="Aog.UI.Avalonia.Views.Shell.TopToolbarView"
             x:DataType="vm:TopToolbarViewModel">
  <ItemsControl Items="{Binding Items}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="12"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:TopToolbarItemViewModel">
        <ToggleButton Content="{Binding DisplayName}"
                      Command="{Binding Command}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      MinWidth="110"
                      Padding="12,6"
                      CornerRadius="8"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      Background="{DynamicResource ThemeBackgroundBrush}"
                      Foreground="{DynamicResource ThemeForegroundBrush}"
                      FontWeight="SemiBold">
          <ToggleButton.ToolTip>
            <ToolTip Content="{Binding Tooltip}"/>
          </ToggleButton.ToolTip>
        </ToggleButton>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
