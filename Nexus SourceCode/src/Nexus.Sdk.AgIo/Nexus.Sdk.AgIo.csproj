<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <PackageId>AgOpenGPS.Nexus.Sdk.AgIo</PackageId>
    <Authors>AgOpenGPS</Authors>
    <Description>AgIO sidecar contracts for the Nexus plugin SDK.</Description>
    <PackageTags>AgOpenGPS;Nexus;SDK;AgIO;Plugins</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nexus.Sdk.Core/Nexus.Sdk.Core.csproj" />
  </ItemGroup>
</Project>
