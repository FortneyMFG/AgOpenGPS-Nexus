{"schemaVersion":"1.0.0","id":"org.agopengps.plugins.gnss-imu-fusion","name":"GNSS + IMU Fusion","version":"1.0.0","description":"Fuses GNSS, IMU, and wheel speed inputs into a stabilized pose stream with quality metrics for guidance consumers.","requiredApis":{"core.runtime":">=1.0.0","agio.sensors":">=1.0.0","plugins.ntrip-client":">=1.0.0"},"settings":{"poseQualityWindowSeconds":3,"imuBiasDriftLimitDps":0.5,"wheelSpeedWeight":0.35,"rtkHoldTimeoutSeconds":2},"supportedCapabilities":["navigation.pose","navigation.imu","navigation.pose.quality"],"requiredTransports":["core://pose","core://imu","serial://serial1","can://can0"],"minimumRuntimeVersion":"1.0.0","simProviders":[{"providerId":"gnss.poseFusion","type":"Aog.Plugins.GnssImuFusion.PoseFusionProvider","topics":["vehicle.pose.fused"],"description":"Synthesizes fused pose samples derived from GNSS, IMU, and wheel speed inputs.","settings":{"poseNoiseStdDev":[0.025,0.025,0.5],"updateRateHz":20}},{"providerId":"gnss.imuFusion","type":"Aog.Plugins.GnssImuFusion.ImuFusionProvider","topics":["vehicle.imu.fused"],"description":"Generates IMU telemetry aligned with the fusion pose stream for integration tests.","settings":{"gyroBiasDps":[0.01,-0.02,0.005],"accelBiasMps2":[0.05,0.04,0.1]}}],"leases":[{"capability":"navigation.pose","mode":"Exclusive","timeoutSeconds":5,"recovery":"FailSafe"},{"capability":"navigation.imu","mode":"Shared","timeoutSeconds":5,"recovery":"GracefulDegradation"},{"capability":"navigation.pose.quality","mode":"Shared","timeoutSeconds":5,"recovery":"GracefulDegradation"}]}