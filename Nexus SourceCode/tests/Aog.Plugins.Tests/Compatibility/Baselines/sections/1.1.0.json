{
  "schemaVersion": "1.0.0",
  "id": "org.agopengps.plugins.sections",
  "name": "Sections Control",
  "version": "1.1.0",
  "description": "Implements section tasking, rate control, and telemetry publishing.",
  "requiredApis": {
    "core": ">=1.0.0",
    "sim": ">=1.0.0"
  },
  "settings": {
    "defaultBoomCount": 12,
    "rateChangeLatencyMs": 120
  },
  "supportedCapabilities": [
    "sections.control",
    "sections.telemetry"
  ],
  "requiredTransports": [
    "AOG-Link",
    "core://sections"
  ],
  "minimumRuntimeVersion": "1.0.0",
  "simProviders": [
    {
      "providerId": "sections.taskGenerator",
      "type": "Aog.Plugins.Sections.TaskGeneratorProvider",
      "topics": [
        "sections.tasking"
      ],
      "description": "Produces section enable/disable tasking based on guidance.",
      "settings": {
        "coverageWidthMeters": 36.0
      }
    },
    {
      "providerId": "sections.rateController",
      "type": "Aog.Plugins.Sections.RateControllerProvider",
      "topics": [
        "sections.command"
      ],
      "description": "Applies hysteresis and look-ahead to tasking events before publishing commands.",
      "settings": {
        "lookAheadMeters": 3.5,
        "minSpeedKph": 4.0
      }
    },
    {
      "providerId": "sections.telemetry",
      "type": "Aog.Plugins.Sections.TelemetryProvider",
      "topics": [
        "sections.telemetry"
      ],
      "description": "Publishes aggregate duty cycle and switch feedback telemetry.",
      "settings": {
        "samplePeriodMs": 200
      }
    }
  ],
  "leases": [
    {
      "capability": "sections.control",
      "mode": "Exclusive",
      "timeoutSeconds": 5,
      "recovery": "FailSafe"
    },
    {
      "capability": "sections.telemetry",
      "mode": "Shared",
      "timeoutSeconds": 10,
      "recovery": "GracefulDegradation"
    }
  ]
}
