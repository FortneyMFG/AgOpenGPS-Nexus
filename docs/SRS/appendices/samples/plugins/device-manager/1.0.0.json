{
  "schemaVersion": "1.0.0",
  "id": "org.agopengps.plugins.device-manager",
  "name": "Device Manager",
  "version": "1.0.0",
  "description": "Discovers devices, reports firmware versions, and exposes hardware health metrics for Nexus operators.",
  "requiredApis": {
    "core": ">=1.0.0",
    "agio": ">=1.0.0"
  },
  "settings": {
    "inventoryPollPeriodSeconds": 5,
    "healthRetentionWindow": "P3D",
    "firmwareFeedUri": "https://updates.agopengps.org/device-manager.json"
  },
  "supportedCapabilities": [
    "devices.inventory",
    "devices.health",
    "devices.firmware"
  ],
  "requiredTransports": [
    "core://devices",
    "agio://inventory"
  ],
  "minimumRuntimeVersion": "1.0.0",
  "simProviders": [
    {
      "providerId": "device-manager.inventory",
      "type": "Aog.Plugins.DeviceManager.InventorySimulationProvider",
      "topics": [
        "devices.inventory"
      ],
      "description": "Publishes deterministic inventory snapshots sourced from AgIO discovery events.",
      "settings": {
        "fleetSize": 6,
        "pollIntervalSeconds": 5
      }
    },
    {
      "providerId": "device-manager.health",
      "type": "Aog.Plugins.DeviceManager.HealthSimulationProvider",
      "topics": [
        "devices.health"
      ],
      "description": "Synthesizes health telemetry with configurable warning and fault profiles.",
      "settings": {
        "warningRate": 0.05,
        "criticalRate": 0.01
      }
    }
  ],
  "leases": [
    {
      "capability": "devices.inventory",
      "mode": "Exclusive",
      "timeoutSeconds": 15,
      "recovery": "GracefulDegradation"
    },
    {
      "capability": "devices.health",
      "mode": "Shared",
      "timeoutSeconds": 10,
      "recovery": "GracefulDegradation"
    },
    {
      "capability": "devices.firmware",
      "mode": "Exclusive",
      "timeoutSeconds": 20,
      "recovery": "FailSafe"
    }
  ]
}
