{
  "schemaVersion": "1.0.0",
  "id": "org.agopengps.plugins.telemetry-logging",
  "name": "Telemetry Logging",
  "version": "1.0.0",
  "description": "Captures session telemetry, diagnostics, and replay artifacts.",
  "requiredApis": {
    "core": ">=1.0.0"
  },
  "settings": {
    "rootDirectory": "~/AgOpenGPS/telemetry",
    "metadataFileName": "session.json"
  },
  "supportedCapabilities": [
    "telemetry.logging"
  ],
  "requiredTransports": [
    "core://telemetry"
  ]
}
