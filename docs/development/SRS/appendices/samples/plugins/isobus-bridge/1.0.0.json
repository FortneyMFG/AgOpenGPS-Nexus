{
  "schemaVersion": "1.0.0",
  "id": "org.agopengps.plugins.isobus-bridge",
  "name": "ISOBUS Communications Bridge",
  "version": "1.0.0",
  "description": "Bridges ISO 11783 CAN PGNs with the Nexus UDP envelope and records diagnostics.",
  "requiredApis": {
    "aog.core.telemetry": ">=1.0.0",
    "aog.core.capabilities": ">=1.0.0",
    "aog.job.lifecycle": ">=1.0.0"
  },
  "settings": {
    "sourceAddress": {
      "type": "byte",
      "default": 144,
      "description": "Default ISOBUS source address claimed by the bridge."
    },
    "isoName": {
      "type": "string",
      "default": "0x1CFF0E0C8B123456",
      "description": "64-bit ISO NAME (hex) advertised during address claim responses."
    },
    "udpMulticastEndpoint": {
      "type": "string",
      "default": "239.255.76.67:8888",
      "description": "UDP multicast endpoint used for the Nexus PGN mirror."
    }
  },
  "supportedCapabilities": [
    "isobus.task-controller",
    "isobus.universal-terminal",
    "bridge.udp-mirror"
  ],
  "requiredTransports": [
    "can:can0",
    "udp:239.255.76.67:8888"
  ],
  "minimumRuntimeVersion": "1.0.0",
  "simProviders": [
    {
      "providerId": "isobus.router",
      "type": "Aog.Plugins.Isobus.IsobusRouterProvider",
      "topics": [
        "isobus.can",
        "isobus.datagram"
      ],
      "description": "Replays captured ISOBUS traffic between CAN and the Nexus UDP envelope for regression testing.",
      "settings": {
        "datagramTopic": "isobus/udp",
        "canTopic": "bus/can0"
      }
    }
  ],
  "leases": [
    {
      "capability": "isobus.task-controller",
      "mode": "Exclusive",
      "timeoutSeconds": 5,
      "recovery": "FailSafe"
    },
    {
      "capability": "isobus.universal-terminal",
      "mode": "Exclusive",
      "timeoutSeconds": 5,
      "recovery": "GracefulDegradation"
    },
    {
      "capability": "bridge.udp-mirror",
      "mode": "Shared",
      "timeoutSeconds": 10,
      "recovery": "GracefulDegradation"
    }
  ]
}
