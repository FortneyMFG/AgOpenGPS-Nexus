{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/plugin_manifest.schema.json",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[-0-9A-Za-z.]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "classification": {
      "type": "string",
      "enum": ["Hard", "Soft", "Suggest"],
      "default": "Hard"
    },
    "capabilityDescriptor": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" },
        "features": {
          "type": "object",
          "description": "Optional feature flags the capability implements with semantic versions.",
          "additionalProperties": { "$ref": "#/$defs/semver" },
          "default": {}
        }
      }
    },
    "profileDescriptor": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "required": ["id", "range"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "range": { "type": "string" },
        "features": {
          "type": "object",
          "description": "Feature-level range requirements declared by the consumer.",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "profileRequirement": {
      "type": "object",
      "required": ["id", "range"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "range": { "type": "string" },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "relationshipRequirement": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "range": { "type": "string" },
        "reason": { "type": "string" },
        "classification": { "$ref": "#/$defs/classification" }
      }
    },
    "conformanceAttestation": {
      "type": "object",
      "required": ["profile", "runner", "result", "sha256"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string" },
        "runner": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "sha256": { "type": "string" }
      }
    }
  },
  "title": "AgOpenGPS Plugin Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "targets",
    "entry",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$",
      "description": "Reverse-DNS identifier for the plugin."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[-0-9A-Za-z.]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of the plugin."
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "targets": {
      "type": "object",
      "required": ["core", "ui"],
      "additionalProperties": false,
      "properties": {
        "core": { "type": "string", "description": "SemVer range for core host compatibility." },
        "ui": { "type": "string", "description": "SemVer range for UI host compatibility." }
      }
    },
    "entry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "object",
          "required": ["exe"],
          "additionalProperties": false,
          "properties": {
            "exe": { "type": "string", "description": "Relative path to the backend executable or script." },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Command-line arguments with token substitution support."
            },
            "protocol": { "type": "string", "enum": ["grpc", "http", "ipc", "custom"], "default": "grpc" }
          }
        },
        "ui": {
          "type": "object",
          "required": ["module"],
          "additionalProperties": false,
          "properties": {
            "module": { "type": "string", "description": "Relative path to the UI assembly or bundle." },
            "type": { "type": "string", "description": "Factory type or exported symbol exposed by the UI module." }
          }
        }
      },
      "description": "Entry points for backend services and UI modules."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "properties": {
        "serial": { "type": "array", "items": { "type": "string" } },
        "socketcan": { "type": "array", "items": { "type": "string" } },
        "network": { "type": "array", "items": { "type": "string" } },
        "filesystem": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityDescriptor" },
          "default": []
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileDescriptor" },
          "default": []
        }
      },
      "default": {}
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityRequirement" },
          "default": []
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profileRequirement" },
          "default": []
        },
        "peerOf": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipRequirement" },
          "default": []
        },
        "conflictsWith": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipRequirement" },
          "default": []
        },
        "replaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipRequirement" },
          "default": []
        },
        "extends": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipRequirement" },
          "default": []
        }
      },
      "default": {}
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": { "type": "array", "items": { "type": "string" } },
        "gauges": { "type": "array", "items": { "type": "string" } },
        "menus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "command"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "command": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "required": ["alg", "sig"],
      "additionalProperties": false,
      "properties": {
        "alg": { "type": "string", "enum": ["ed25519", "rsa-2048", "rsa-4096"] },
        "sig": { "type": "string", "description": "Base64 signature of the ZIP payload." },
        "pub": { "type": "string", "description": "Base64 public key if not already trusted." }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["github", "url", "custom"] },
        "repo": { "type": "string", "description": "GitHub org/repo slug." },
        "assetPattern": { "type": "string", "description": "Glob or regex matching release asset names." },
        "channel": { "type": "string", "enum": ["stable", "beta", "alpha", "pinned"] }
      },
      "required": ["provider"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conformance": {
          "type": "array",
          "items": { "$ref": "#/$defs/conformanceAttestation" },
          "default": []
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icons": { "type": "array", "items": { "type": "string" } },
        "localization": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
