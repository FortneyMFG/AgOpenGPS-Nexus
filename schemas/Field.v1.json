{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/Field.v1.json",
  "title": "Field.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "farmId", "name", "polygons", "createdBy", "createdAt", "lastModifiedAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$",
      "default": "1.0.0",
      "description": "Schema semantic version for field documents.",
      "x-nexus-scope": "core"
    },
    "id": {
      "type": "string",
      "pattern": "^field:[A-Za-z0-9._-]+$",
      "description": "Stable field identifier within the owning farm.",
      "x-nexus-scope": "core"
    },
    "farmId": {
      "type": "string",
      "pattern": "^farm:[A-Za-z0-9._-]+$",
      "description": "Identifier of the farm that owns the field.",
      "x-nexus-scope": "core"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable label displayed in navigators and analytics.",
      "x-nexus-scope": "core"
    },
    "polygons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/polygon" },
      "description": "One or more exterior footprints that define the field boundary.",
      "x-nexus-scope": "core"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional labels used for filtering or grouping fields.",
      "x-nexus-scope": "core"
    },
    "headlands": {
      "type": "array",
      "items": { "$ref": "#/$defs/headland" },
      "description": "Optional headland definitions derived from the polygons.",
      "x-nexus-scope": "core"
    },
    "notes": {
      "type": "string",
      "description": "Operator notes specific to the field.",
      "x-nexus-scope": "core"
    },
    "createdBy": {
      "type": "string",
      "description": "Actor that created the field record (user:*, system:*).",
      "x-nexus-scope": "core"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the field record was created (UTC).",
      "x-nexus-scope": "core"
    },
    "lastModifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent modification to the field geometry or metadata.",
      "x-nexus-scope": "core"
    },
    "extensions": {
      "type": "object",
      "description": "Plugin-owned metadata (soil zones, crop history, profitability markers). Keys follow <namespace>.<topic> naming.",
      "additionalProperties": true,
      "x-nexus-scope": "plugin"
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 3,
      "description": "Coordinate expressed as [lon, lat] or [lon, lat, elevation].",
      "x-nexus-scope": "core"
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/coordinate" },
      "description": "Linear ring with closed coordinates (first == last).",
      "x-nexus-scope": "core"
    },
    "polygon": {
      "type": "object",
      "required": ["exterior"],
      "additionalProperties": false,
      "properties": {
        "exterior": { "$ref": "#/$defs/ring", "x-nexus-scope": "core" },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ring" },
          "description": "Interior holes within the polygon.",
          "x-nexus-scope": "core"
        }
      }
    },
    "headland": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width"],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "Headland width measured outward from the boundary.",
          "x-nexus-scope": "core"
        },
        "units": {
          "type": "string",
          "enum": ["m", "ft"],
          "default": "m",
          "description": "Measurement units for the width.",
          "x-nexus-scope": "core"
        },
        "passCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional number of passes when carving headlands.",
          "x-nexus-scope": "core"
        },
        "notes": {
          "type": "string",
          "description": "Operator notes about headland usage.",
          "x-nexus-scope": "core"
        }
      }
    }
  }
}
