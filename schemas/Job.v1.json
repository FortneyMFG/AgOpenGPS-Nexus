{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/Job.v1.json",
  "title": "Job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "farmId", "fieldIds", "operation", "createdBy", "createdAt", "lastModifiedAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$",
      "default": "1.0.0",
      "description": "Schema semantic version for job documents.",
      "x-nexus-scope": "core"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polygons"],
      "description": "Resolved union geometry spanning all mounted fields for the job.",
      "x-nexus-scope": "core",
      "properties": {
        "polygons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/polygon" },
          "description": "Union polygons describing the mounted field envelope in the project CRS.",
          "x-nexus-scope": "core"
        },
        "members": {
          "type": "array",
          "description": "Optional per-field envelope geometry retained for analytics and overlay alignment.",
          "items": {
            "type": "object",
            "required": ["fieldId", "polygons"],
            "additionalProperties": false,
            "properties": {
              "fieldId": {
                "type": "string",
                "pattern": "^field:[A-Za-z0-9._:-]+$",
                "description": "Identifier of the mounted field represented by the member envelope.",
                "x-nexus-scope": "core"
              },
              "polygons": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/polygon" },
                "description": "Resolved polygons for the mounted field after clipping and normalization.",
                "x-nexus-scope": "core"
              },
              "areaHa": {
                "type": "number",
                "minimum": 0,
                "description": "Total hectares represented by the member envelope.",
                "x-nexus-scope": "core"
              },
              "extensions": {
                "type": "object",
                "description": "Plugin-owned metadata aligned to the member envelope (e.g., crop type overlays).",
                "additionalProperties": true,
                "x-nexus-scope": "plugin"
              }
            }
          },
          "x-nexus-scope": "core"
        },
        "boundingBox": {
          "$ref": "#/$defs/boundingBox",
          "description": "Axis-aligned bounding box enclosing the union envelope.",
          "x-nexus-scope": "core"
        },
        "centroid": {
          "$ref": "#/$defs/coordinate",
          "description": "Centroid of the union envelope expressed as [lon, lat] or [lon, lat, elevation].",
          "x-nexus-scope": "core"
        },
        "areaHa": {
          "type": "number",
          "minimum": 0,
          "description": "Total hectares covered by the union envelope.",
          "x-nexus-scope": "core"
        },
        "crsEpsg": {
          "type": "integer",
          "minimum": 0,
          "description": "EPSG code describing the coordinate reference system used for the envelope polygons.",
          "x-nexus-scope": "core"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^job:[A-Za-z0-9._:-]+$",
      "description": "Stable identifier for the job across systems.",
      "x-nexus-scope": "core"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable job name shown in navigators and analytics.",
      "x-nexus-scope": "core"
    },
    "seasonId": {
      "type": ["string", "null"],
      "pattern": "^season:[A-Za-z0-9._:-]+$",
      "description": "Optional reference to the season that organizes the job.",
      "x-nexus-scope": "core"
    },
    "farmId": {
      "type": "string",
      "pattern": "^farm:[A-Za-z0-9._:-]+$",
      "description": "Primary farm associated with the job.",
      "x-nexus-scope": "core"
    },
    "fieldIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^field:[A-Za-z0-9._:-]+$"
      },
      "description": "Fields mounted by the job.",
      "x-nexus-scope": "core"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "description": "Operation classification (planting, spraying, harvest, etc.).",
      "x-nexus-scope": "core"
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "x-nexus-scope": "core",
      "properties": {
        "planned": {
          "type": "string",
          "format": "date",
          "description": "Planned start date for the job.",
          "x-nexus-scope": "core"
        },
        "actualStart": {
          "type": "string",
          "format": "date-time",
          "description": "Actual start timestamp for the job.",
          "x-nexus-scope": "core"
        },
        "actualEnd": {
          "type": "string",
          "format": "date-time",
          "description": "Actual end timestamp for the job.",
          "x-nexus-scope": "core"
        }
      },
      "description": "Planned and actual timing metadata for the job."
    },
    "sessions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^session:[A-Za-z0-9._:-]+$" },
          { "$ref": "./Session.v1.json" }
        ]
      },
      "description": "Sessions executed within the job, either as identifiers or embedded session documents.",
      "x-nexus-scope": "core"
    },
    "stats": {
      "type": "object",
      "description": "Aggregated statistics for the job and per-field rollups.",
      "x-nexus-scope": "core",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fieldId"],
            "additionalProperties": true,
            "properties": {
              "fieldId": {
                "type": "string",
                "pattern": "^field:[A-Za-z0-9._:-]+$",
                "x-nexus-scope": "core"
              },
              "areaHa": {
                "type": "number",
                "minimum": 0,
                "description": "Hectares attributed to the field for rollup analytics.",
                "x-nexus-scope": "core"
              }
            }
          },
          "description": "Per-field statistics recorded for the job.",
          "x-nexus-scope": "core"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Operator notes for the overall job.",
      "x-nexus-scope": "core"
    },
    "createdBy": {
      "type": "string",
      "description": "Actor that created the job (user:*, system:*).",
      "x-nexus-scope": "core"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the job was created (UTC).",
      "x-nexus-scope": "core"
    },
    "lastModifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent job modification.",
      "x-nexus-scope": "core"
    },
    "extensions": {
      "type": "object",
      "description": "Plugin-owned metadata (crop genetics, profitability, zone analytics). Keys follow <namespace>.<topic> naming.",
      "additionalProperties": true,
      "x-nexus-scope": "plugin"
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 3,
      "description": "Coordinate expressed as [lon, lat] or [lon, lat, elevation].",
      "x-nexus-scope": "core"
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/coordinate" },
      "description": "Linear ring with closed coordinates (first == last).",
      "x-nexus-scope": "core"
    },
    "polygon": {
      "type": "object",
      "required": ["exterior"],
      "additionalProperties": false,
      "properties": {
        "exterior": { "$ref": "#/$defs/ring", "x-nexus-scope": "core" },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ring" },
          "description": "Interior holes within the polygon.",
          "x-nexus-scope": "core"
        }
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLon", "minLat", "maxLon", "maxLat"],
      "properties": {
        "minLon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Minimum longitude bound for the envelope.",
          "x-nexus-scope": "core"
        },
        "minLat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Minimum latitude bound for the envelope.",
          "x-nexus-scope": "core"
        },
        "maxLon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Maximum longitude bound for the envelope.",
          "x-nexus-scope": "core"
        },
        "maxLat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Maximum latitude bound for the envelope.",
          "x-nexus-scope": "core"
        }
      }
    }
  }
}
