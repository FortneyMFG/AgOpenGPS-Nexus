{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/SectionStateTally.v1.json",
  "title": "SectionStateTally.v1",
  "description": "Aggregated SectionState opportunity and event tallies for deterministic replay validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "jobId",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$",
      "default": "1.0.0",
      "description": "Semantic version for SectionState tally exports.",
      "x-nexus-scope": "core"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the tallies were generated.",
      "x-nexus-scope": "core"
    },
    "jobId": {
      "type": "string",
      "pattern": "^job:[A-Za-z0-9._:-]+$",
      "description": "Job identifier associated with the tallies.",
      "x-nexus-scope": "core"
    },
    "sessionId": {
      "type": ["string", "null"],
      "pattern": "^session:[A-Za-z0-9._:-]+$",
      "description": "Optional session identifier.",
      "x-nexus-scope": "core"
    },
    "farmId": {
      "type": "string",
      "pattern": "^farm:[A-Za-z0-9._:-]+$",
      "description": "Farm identifier for the job.",
      "x-nexus-scope": "core"
    },
    "fieldIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^field:[A-Za-z0-9._:-]+$"
      },
      "description": "Fields included in the tallies.",
      "x-nexus-scope": "core"
    },
    "zoneRegistryHash": {
      "type": ["string", "null"],
      "description": "Zone registry hash referenced by the tallies.",
      "x-nexus-scope": "core"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      },
      "description": "Per-section tallies derived from the PoseStream timeline.",
      "x-nexus-scope": "core"
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolbarId",
        "sectionId",
        "opportunityDurationSeconds",
        "activeDurationSeconds",
        "commandCount",
        "eventCount"
      ],
      "properties": {
        "toolbarId": {
          "type": "string",
          "pattern": "^toolbar:[A-Za-z0-9._:-]+$",
          "description": "Toolbar owning the section.",
          "x-nexus-scope": "core"
        },
        "sectionId": {
          "type": "string",
          "pattern": "^section:[A-Za-z0-9._:-]+$",
          "description": "Section identifier.",
          "x-nexus-scope": "core"
        },
        "commandedState": {
          "type": "string",
          "enum": ["unspecified", "off", "armed", "on"],
          "description": "Last commanded state observed in the replay window.",
          "x-nexus-scope": "core"
        },
        "measuredState": {
          "type": "string",
          "enum": ["unspecified", "off", "armed", "on"],
          "description": "Last measured state observed in the replay window.",
          "x-nexus-scope": "core"
        },
        "manualOverride": {
          "type": ["boolean", "null"],
          "description": "Whether an operator override was active at the end of the window.",
          "x-nexus-scope": "core"
        },
        "opportunityDurationSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Cumulative opportunity duration in seconds.",
          "x-nexus-scope": "core"
        },
        "activeDurationSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Cumulative active duration in seconds.",
          "x-nexus-scope": "core"
        },
        "commandCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of commanded state transitions.",
          "x-nexus-scope": "core"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of work events observed.",
          "x-nexus-scope": "core"
        },
        "appliedAreaSqMeters": {
          "type": "number",
          "minimum": 0,
          "description": "Total applied area across the replay window.",
          "x-nexus-scope": "core"
        },
        "missedAreaSqMeters": {
          "type": "number",
          "minimum": 0,
          "description": "Total missed opportunity area across the replay window.",
          "x-nexus-scope": "core"
        }
      }
    }
  }
}

