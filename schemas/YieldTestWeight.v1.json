{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/YieldTestWeight.v1.json",
  "title": "YieldTestWeight.v1",
  "type": "object",
  "additionalProperties": false,
  "x-nexus-layerId": "yield.testWeight",
  "x-nexus-actual": true,
  "required": ["layerId", "jobId", "sessionId", "units", "createdBy", "createdAt"],
  "properties": {
    "layerId": {"type": "string", "pattern": "^layer:[A-Za-z0-9._:-]+$", "description": "Layer identifier", "x-nexus-scope": "core"},
    "jobId": {"type": "string", "pattern": "^job:[A-Za-z0-9._:-]+$", "description": "Job identifier", "x-nexus-scope": "core"},
    "sessionId": {"type": "string", "pattern": "^session:[A-Za-z0-9._:-]+$", "description": "Session identifier", "x-nexus-scope": "core"},
    "fieldId": {"type": ["string", "null"], "pattern": "^field:[A-Za-z0-9._:-]+$", "description": "Optional field", "x-nexus-scope": "core"},
    "units": {"type": "string", "description": "Units (e.g., lb/bu)", "x-nexus-scope": "core"},
    "calibration": {"type": ["string", "null"], "description": "Calibration metadata", "x-nexus-scope": "plugin"},
    "createdBy": {"type": "string", "description": "Actor generating the layer", "x-nexus-scope": "core"},
    "createdAt": {"type": "string", "format": "date-time", "description": "Creation timestamp", "x-nexus-scope": "core"},
    "extensions": {"type": "object", "description": "Plugin metadata", "additionalProperties": true, "x-nexus-scope": "plugin"}
  }
}
