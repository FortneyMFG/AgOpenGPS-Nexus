[Unit]
Description=AOG AGiO hardware bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aogsvc
Group=aogsvc
SupplementaryGroups=dialout plugdev
WorkingDirectory=/usr/lib/aog/agio
EnvironmentFile=-/etc/aog/agio.env
ExecStart=/usr/bin/aog-agio
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
StateDirectory=aog
LogsDirectory=aog
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
