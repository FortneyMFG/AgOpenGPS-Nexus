{
  "rigName": "BenchRig-01",
  "controllerEndpoint": "http://127.0.0.1:5105",
  "streamBindings": ["pose", "imu", "sections"],
  "scenarios": [
    {
      "name": "Warm start",
      "description": "Verify steering engages under load",
      "durationSeconds": 180,
      "sampleData": "metrics/warm-start.json",
      "assertions": [
        { "metric": "pose.rms_error", "max": 0.08, "unit": "m" },
        { "metric": "steer.engage_latency_ms", "max": 150, "unit": "ms" },
        { "metric": "sections.dropout_count", "max": 0, "unit": "count" }
      ]
    },
    {
      "name": "Headland return",
      "description": "Ensure sections recover after manual override",
      "durationSeconds": 120,
      "sampleData": "metrics/headland.json",
      "assertions": [
        { "metric": "sections.recovery_time_ms", "max": 2500, "unit": "ms" },
        { "metric": "steer.hold_error_cm", "max": 4.5, "unit": "cm" }
      ]
    }
  ]
}
