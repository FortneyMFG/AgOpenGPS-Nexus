{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/agio.schema.json",
  "title": "Nexus AGiO host configuration",
  "type": "object",
  "required": ["schemaVersion", "backends", "transports"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Semantic version of the AGiO configuration contract."
    },
    "transports": {
      "type": "object",
      "required": ["serial", "network"],
      "additionalProperties": false,
      "properties": {
        "serial": {
          "type": "array",
          "items": {"$ref": "#/$defs/serialPort"},
          "description": "Serial devices enumerated for GNSS, IMU, steering, and section controllers."
        },
        "network": {
          "type": "object",
          "required": ["udp", "grpc"],
          "additionalProperties": false,
          "properties": {
            "udp": {
              "type": "array",
              "items": {"$ref": "#/$defs/networkEndpoint"},
              "description": "UDP endpoints bridged to PGNs or legacy telemetry sources."
            },
            "grpc": {
              "type": "array",
              "items": {"$ref": "#/$defs/networkEndpoint"},
              "description": "gRPC endpoints exposed to Core clients."
            }
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/backend"},
      "description": "Backend modules that adapt transports into Core-facing services."
    },
    "ntrip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "caster": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "mountpoint": {"type": "string"},
        "username": {"type": "string"},
        "password": {"type": "string"},
        "sendGga": {"type": "boolean", "default": true}
      },
      "description": "Optional NTRIP corrections forwarded to GNSS transports."
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heartbeatMs": {
          "type": "integer",
          "minimum": 100,
          "description": "Heartbeat interval required to keep actuators enabled."
        },
        "failsafe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steer": {"type": "string", "enum": ["disable", "hold"]},
            "sections": {"type": "string", "enum": ["disable", "hold"]}
          }
        }
      },
      "description": "Safety policies enforced when connectivity or health checks fail."
    }
  },
  "$defs": {
    "serialPort": {
      "type": "object",
      "required": ["port", "baud", "role"],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "string",
          "description": "Device path or Windows COM name."
        },
        "baud": {
          "type": "integer",
          "enum": [4800, 9600, 19200, 38400, 57600, 115200, 230400],
          "description": "Serial line speed."
        },
        "role": {
          "type": "string",
          "enum": ["gnss", "imu", "steer", "sections", "timing"],
          "description": "Logical channel served by the serial link."
        },
        "parity": {
          "type": "string",
          "enum": ["none", "odd", "even"],
          "default": "none"
        },
        "dataBits": {
          "type": "integer",
          "enum": [7, 8],
          "default": 8
        },
        "stopBits": {
          "type": "number",
          "enum": [1, 1.5, 2],
          "default": 1
        }
      }
    },
    "networkEndpoint": {
      "type": "object",
      "required": ["host", "port"],
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "format": "hostname"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "topic": {
          "type": "string",
          "description": "Optional topic identifier associated with the endpoint."
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["backendId", "type"],
      "additionalProperties": false,
      "properties": {
        "backendId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Unique identifier for the backend module."
        },
        "type": {
          "type": "string",
          "description": "Fully-qualified type name or manifest identifier."
        },
        "settings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "anyOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"}
            ]
          }
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": "Transport identifiers consumed by the backend."
        }
      }
    }
  }
}
