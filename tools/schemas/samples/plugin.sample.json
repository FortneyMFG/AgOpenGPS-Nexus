{
  "schemaVersion": "1.0.0",
  "id": "org.agopengps.plugins.autosteer-lite",
  "name": "AutoSteer Lite",
  "version": "1.2.0",
  "description": "Pure pursuit and Stanley steering with bundled simulation providers.",
  "requiredApis": {
    "core": ">=1.0.0",
    "sim": ">=1.0.0"
  },
  "settings": {
    "defaultMode": "pure-pursuit",
    "maxLookAhead": 12.5,
    "lookAheadSeconds": {
      "type": "number",
      "default": 0.8,
      "description": "Time horizon used by the pure pursuit controller."
    }
  },
  "supportedCapabilities": [
    "guidance.control",
    "guidance.telemetry"
  ],
  "requiredTransports": [
    "AOG-Link",
    "core://guidance"
  ],
  "minimumRuntimeVersion": "1.0.0",
  "simProviders": [
    {
      "providerId": "autosteer.vehicle",
      "type": "Aog.Plugins.Autosteer.VehicleProvider",
      "topics": ["pose", "steer"],
      "settings": {
        "wheelbase": 2.8,
        "latencyMs": 40
      }
    },
    {
      "providerId": "gnss.basic",
      "type": "Aog.Plugins.Sim.GnssProvider",
      "topics": ["pose"],
      "settings": {
        "horizontalNoise": 0.15,
        "dropoutProbability": 0.01
      }
    }
  ],
  "leases": [
    {
      "capability": "guidance.control",
      "mode": "Exclusive",
      "timeoutSeconds": 5,
      "recovery": "FailSafe"
    },
    {
      "capability": "guidance.telemetry",
      "mode": "Shared",
      "timeoutSeconds": 10,
      "recovery": "GracefulDegradation"
    }
  ],
  "reportSections": [
    {
      "id": "org.agopengps.reports.sections.guidance-summary",
      "displayName": "Guidance Summary",
      "description": "Charts steering engagement, coverage, and overlap metrics.",
      "version": "1.0.0",
      "scopes": ["season", "job", "session"],
      "capabilities": ["telemetry", "guidance"],
      "provides": {
        "pdf": true,
        "csv": true
      },
      "defaultLayout": {
        "region": "body",
        "order": 40,
        "column": 0,
        "columnSpan": 2
      },
      "optionsSchema": "https://agopengps.org/schemas/report-sections/guidance-summary-options.schema.json",
      "defaultOptions": {
        "includeCharts": true,
        "maxSessions": 5
      },
      "defaultExports": {
        "csv": [
          {
            "filename": "guidance-summary.csv",
            "columns": ["fieldName", "hoursEngaged", "overlapPercent", "coverageHectares"]
          }
        ]
      }
    }
  ]
}
