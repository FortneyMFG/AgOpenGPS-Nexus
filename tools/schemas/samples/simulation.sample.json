{
  "schemaVersion": "1.0.0",
  "providers": [
    {
      "providerId": "sim.pose.basic",
      "type": "Aog.Sim.BasicPoseProvider",
      "settings": {
        "updateHz": 20,
        "noiseMeters": 0.05
      },
      "outputs": ["pose"]
    },
    {
      "providerId": "sim.vehicle.dynamics",
      "type": "Aog.Sim.Vehicle.BicycleModel",
      "settings": {
        "wheelbaseMeters": 2.8,
        "maxSteerAngleDeg": 27
      },
      "inputs": ["steerCommand"],
      "outputs": ["steerState"]
    }
  ],
  "routes": [
    {"stream": "pose", "source": "sim.pose.basic", "mode": "simulation"},
    {"stream": "steer", "source": "sim.vehicle.dynamics", "mode": "simulation"}
  ],
  "options": {
    "seed": 1337,
    "timeScale": 1.0
  },
  "scenarios": [
    {
      "scenarioId": "sample-scenario",
      "description": "Default deterministic loop for smoke testing.",
      "routes": [
        {"stream": "pose", "source": "sim.pose.basic", "mode": "simulation"},
        {"stream": "steer", "source": "sim.vehicle.dynamics", "mode": "simulation"}
      ],
      "options": {
        "timeScale": 1.0
      }
    }
  ]
}
