{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agopengps.org/schemas/season.schema.json",
  "title": "AgOpenGPS Nexus season organizer metadata (aog.season.v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seasonId",
    "displayName",
    "dateRange",
    "createdBy",
    "createdAt",
    "lastModifiedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Semantic version of the season organizer contract."
    },
    "seasonId": {
      "$ref": "#/$defs/seasonId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Human friendly name rendered in navigators and reports."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,}$",
      "description": "Filesystem and URL friendly slug derived from the display name."
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "description": "Inclusive season start date (ISO-8601)."
        },
        "end": {
          "type": "string",
          "format": "date",
          "description": "Inclusive season end date (ISO-8601)."
        }
      },
      "description": "Canonical date window for the season organizer."
    },
    "jobIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jobId"
      },
      "uniqueItems": true,
      "description": "Jobs organized by the season. May be empty for planning shells."
    },
    "notes": {
      "type": "string",
      "description": "Operator supplied notes surfaced in dashboards and exports."
    },
    "optimizerState": {
      "type": ["object", "array", "string", "number", "boolean", "null"],
      "description": "Opaque planner payload captured for resuming optimizers."
    },
    "createdBy": {
      "$ref": "#/$defs/actorId"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "lastModifiedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "extensions": {
      "type": "object",
      "description": "Plugin-owned metadata keyed by <namespace>.<topic>.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp recorded in ISO-8601 format."
    },
    "seasonId": {
      "type": "string",
      "pattern": "^season:[A-Za-z0-9._:-]+$",
      "description": "Stable identifier for the season organizer."
    },
    "jobId": {
      "type": "string",
      "pattern": "^job:[A-Za-z0-9._:-]+$",
      "description": "Identifier of a job associated with the season."
    },
    "actorId": {
      "type": "string",
      "pattern": "^[a-z]+:[A-Za-z0-9._:-]+$",
      "description": "Actor responsible for creating the season (user:*, system:*)."
    }
  }
}
